-- 1. Intro — establish texture fragments and complex bass form
-- Eval 00-setup.tidal first.

setbpm 72

d5 $ spaceTex # gain 0.66
d8 $ bassMain # lpf 260 # gain 0.86

-- after a few cycles, add sparse glitch detail and a hint of harmony
d5 $ stack [spaceTex, glitchTex]
d4 $ chordFlow # lpf 1100
-- let the 8-cycle bass phrase complete at least once before building

-- optional: reveal anchor
d9 $ bassAnchor # lpf 220
