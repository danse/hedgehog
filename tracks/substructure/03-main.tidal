-- 3. Main — full groove, bass remains the complex center

d1 kick
d2 hats
d3 $ degradeBy 0.2 perc
d4 $ stack [chordFlow, sometimes (const chordStabAlt) chordStab]
d5 $ stack [glitchTex, metalTex]

-- bass: main form + anchor
d8 $ bassMain # lpf (range 200 780 $ slow 8 sine) # lpq 0.14
d9 $ bassAnchor

-- bring ghost in/out for movement
-- d10 bassGhost
d10 silence

-- melodic answer (sparse)
d6 motif

-- drive variation (swap in for intensity, then return)
-- d8 bassDrive
d8 $ bassMain # lpf (range 200 780 $ slow 8 sine) # lpq 0.14


d4 stabHit -- alternate melody

d4 $ stack [chordPulse, chordStabAlt] -- swap it back when desired

d6 motifArp
d3 silence
