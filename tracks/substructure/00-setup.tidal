-- Substructure — full track (separate from Hedgehog set)
-- 72 BPM, D minor. Complex bass structure at the center.
-- Eval blocks/paragraphs as needed (C-RET). Uses hedge_sine/hedge_pad/hedge_noise.
-- Gotchas: reverb size <= 0.9; `gain` is amp = amp * gain^4 (trim with gain 0.75..1.0).

setbpm 72

-- ---------------------------------------------------------------------------
-- Bass (complex structure): 8-cycle evolving form + anchor + ghost + drive
-- ---------------------------------------------------------------------------
-- 8
let
  bassA = "<[d2 ~ a2 d3 ~ ~ f2 ~] [d2 ~ ~ a2 ~ c3 ~ bb1] [d2 f2 ~ a2 ~ d3 c3 ~] [bb1 ~ d2 ~ a2 ~ f2 ~]>"
  bassB = "<[d2 ~ a2 ~ f2 d3 ~ c3] [a1 ~ d2 ~ c3 ~ bb1 a1] [d2 a2 ~ f2 ~ d3 ~ c3] [bb1 d2 ~ a2 ~ f2 ~ d2]>"
  bassPhrase = cat [bassA, bassB]  -- 8 cycles

  bassMain = slow 8 $ note bassPhrase # s "hedge_sine"
    # sustain "<0.55 0.35 0.8 0.45 0.3 0.75 0.4 0.5 0.6 0.35 0.85 0.4 0.3 0.7 0.45 0.55>"
    # gain 0.9
    # lpf (slow 4 $ range 150 620 sine)
    # lpq 0.12
    # room 0.18 # size 0.45

  bassAnchor = slow 4 $ note "<d2 a1 bb1 [c2 d2]>" # s "hedge_sine"
    # sustain 0.45 # gain 0.86 # lpf 300 # lpq 0.08 # room 0.12 # size 0.35

  bassGhost = degradeBy 0.45 $ slow 2 $ note "d3 ~ f3 ~ a3 ~ c4 ~" # s "hedge_sine"
    # sustain (range 0.12 0.35 $ slow 3 rand)
    # gain 0.78 # lpf (range 500 1400 $ slow 5 sine) # hpf 120 # room 0.2 # size 0.4

  bassDrive = degradeBy 0.1 $ slow 4 $ note bassPhrase # s "hedge_sine"
    # sustain (range 0.22 0.65 $ slow 3 rand)
    # gain 0.88 # lpf (range 180 980 $ slow 2 sine) # lpq 0.16 # room 0.15 # size 0.4

  bassBreak = slow 8 $ note "<d2 ~ ~ ~ bb1 ~ ~ ~ d2 ~ ~ c2 ~ ~ bb1 ~>" # s "hedge_sine"
    # sustain 0.9 # gain 0.88 # lpf 220 # lpq 0.1 # room 0.22 # size 0.5

-- ---------------------------------------------------------------------------
-- Rhythm / pulse
-- ---------------------------------------------------------------------------
-- 1 kick: sparse, low, supports bass (not a 4/4 club kick)
let kick = slow 2 $ s "808bd(3,8,<0 2 5>)" # gain 0.86 # lpf 180 # room 0.08 # size 0.2

-- 2 hats/clicks: texture pulse
let
  hats = degradeBy 0.25 $ s "hh*8?" # gain (range 0.62 0.78 $ slow 4 rand) # pan (range 0.3 0.7 rand)
    # lpf (range 3500 7000 $ slow 8 sine) # room 0.15 # size 0.25
  click = slow 2 $ s "click:2(3,16,2)" # gain 0.74 # pan 0.35 # room 0.5 # size 0.6 # lpf 2400

-- 3 perc: occasional movement
let perc = degradeBy 0.55 $ slow 2 $ s "~ [clak*2?] ~ [hand? ~]" # gain 0.76 # pan rand # room 0.35 # size 0.45 # lpf 2200

-- ---------------------------------------------------------------------------
-- Harmony / texture / melody (no pads, no drones)
-- ---------------------------------------------------------------------------
-- 4 harmony stabs: pitched fragments (arpy/moog/casio), not sustained beds
let
  chordStab = degradeBy 0.2 $ slow 4 $ n "<[d4,f4,a4] ~ [bb3,d4,f4] ~ [c4,e4,g4] ~ [a3,c4,e4] ~>" # s "arpy"
    # gain 0.84 # legato 0.45 # lpf (range 900 2400 $ slow 8 sine) # room 0.35 # size 0.45
  chordStabAlt = slow 4 $ n "<[d4,a4] [f4,c5] [bb3,f4] [a3,e4]>" # s "moog"
    # gain 0.8 # legato 0.3 # lpf 1600 # room 0.3 # size 0.4
  stabHit = sometimes (fast 2) $ s "stab(3,8,<0 3>)" # n (irand 8) # gain 0.78 # lpf 2200 # room 0.25 # size 0.35

-- 5 texture: fragmented/granular feel from samples (no continuous drone)
let glitchTex = degradeBy 0.35 $ slow 2 $ s "glitch*8?" # n (irand 16) # speed (range 0.7 1.3 $ rand)
    # gain 0.76 # pan rand # lpf (range 1200 5000 $ slow 6 sine) # room 0.3 # size 0.4
let spaceTex = degradeBy 0.5 $ slow 4 $ s "space" # n (irand 12) # speed (range 0.5 1.1 $ slow 4 rand)
    # gain 0.74 # pan rand # hpf 300 # lpf 3200 # room 0.45 # size 0.55
let metalTex = degradeBy 0.6 $ slow 4 $ s "industrial(2,8)" # n (irand 8) # speed 0.9
    # gain 0.72 # pan rand # lpf 2600 # room 0.35 # size 0.45

-- 6 motif: sparse melodic answers
let motif = degradeBy 0.3 $ slow 4 $ note "<d5 ~ a5 ~ f5 ~ e5 ~ ~ c5 ~ a4 ~ d5 ~ ~>" # s "pluck"
    # gain 0.82 # delay 0.65 # delaytime 0.375 # delayfb 0.35 # room 0.8 # size 0.7 # lpf 2600
let motifArp = degradeBy 0.25 $ slow 2 $ n "d5 f5 a5 c6 a5 f5" # s "arpy"
    # gain 0.8 # legato 0.25 # speed (choose [1,1,1,2]) # room 0.4 # size 0.5 # lpf 3200

-- 7 fx
let riser = s "hedge_noise" # sustain 4 # gain (range 0.45 0.84 $ slow 4 saw) # lpf (range 300 5200 $ slow 4 saw) # room 0.8 # size 0.75
let burst = degradeBy 0.2 $ s "glitch(5,16)" # n (irand 16) # gain 0.78 # speed (range 0.8 1.6 $ rand) # room 0.25 # size 0.3

-- convenience
fadeSilence ds n = mapM (\d -> xfadeIn d n $ silence) ds
allOrbits = [1..10]
