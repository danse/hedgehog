-- 2. Build — layer bass complexity, add harmony stabs and pulse

-- open bass filter slowly
d8 $ bassMain # lpf (range 180 520 $ slow 16 sine)

-- structural anchor + ghost detail
d9 $ bassAnchor

d10 $ bassGhost # gain 0.74

-- harmony (more continuous) + texture fragments (no sustained beds)
d4 $ stack [chordFlow # gain 0.78, chordStab # gain 0.76]

d5 $ stack [glitchTex # gain 0.7, degradeBy 0.2 $ spaceTex # gain 0.6]

-- light pulse (no heavy kick yet)
d2 $ click
-- or: d2 $ hats # gain 0.7

-- transition swell into main
-- d7 $ riser
-- d7 $ silence
