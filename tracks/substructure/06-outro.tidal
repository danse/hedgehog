-- 6. Outro — dissolve to bass fragments and sparse texture, then silence

-- remove layers gradually (d1 in case the optional Rebuild kick was used)
xfadeIn 4 16 silence
fadeSilence 8 [7, 9]

fadeSilence 1 [1, 2, 3, 6, 10]

-- bass fragments over sparse texture
d8 $ degradeBy 0.45 $ bassMain # lpf 240
d5 $ degradeBy 0.3 spaceTex

-- final: bass only
d5 silence
xfadeIn 8 16 silence

hush
