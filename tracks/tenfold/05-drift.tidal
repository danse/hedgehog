-- 5. Drift — strip lead/bell/arp, keep pads, texture and long bass

let
  l1 = (, silence) <$> [4,5,6,9]
  l2 = [
    (3, highPad # lpf 1200),
    (7, noiseBed # lpf 900),
    (8, bassLong # lpf 220)]
  in fadeMulti 16 (l1 <> l2)

-- keep the low pad but darker
xfadeIn 2 16 $ lowPad # gain 0.8 # lpf 700

-- eventually leave a single arp note drifting
xfadeIn 4 24 $ degradeBy 0.6 $ arp # gain 0.56
