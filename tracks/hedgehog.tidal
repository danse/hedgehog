import Data.String (fromString)

-- Hedgehog — ambient live set
-- 72 BPM · D minor · ~16 min · five movements.
--
-- Eval the setup block below, then work through the layer blocks in order:
-- bed → texture → pulse → harmony → melody → transitions.
-- See notes/set-plan.md for the movement plan and cue notes.

setbpm 72

-- Layers. Each definition is one paragraph: eval once after boot.
-- Re-eval a definition only when you want to change that instrument.

-- 1
let
  -- `size` must stay <= 0.9: above that the dirt_reverb feedback gain exceeds
  -- unity, the orbit self-oscillates and keeps ringing after hush.
  bed = slow 8 $ bedStudy # room 0.95 # size 0.9 # lpf 1400
  bedStudy = s "padlong"
  -- `gain` is not linear (amp = amp * gain^4); gain 0.5 is -24 dB, not "half".
  -- Keep layers in 0.75..1.0 and trim with `amp` (linear) instead. Baseline is
  -- gain 1.0, so these numbers are the whole mix balance.
  -- 2
  droneStudy n = s "hedge_sine" # note n # gain 0.88 # room 0.8
  droneS n s = slow 8 $ droneStudy n # sustain s
  drone n = droneS n 28 # lpf 240
  d n = d2 $ droneS n 28
  -- 3
  air = slow 4 $ s "wind:4" # speed 0.65 # pan rand # room 0.95 # size 0.9 # lpf 900
  -- 4
  birds = slow 4 $ s "birds:2" # speed (range 0.7 1.05 rand) # pan rand # gain 0.85 # room 0.9 # size 0.85 # lpf 3400
  -- 5
  tick = slow 2 $ s "click:2(3,16,2)" # pan 0.3 # room 0.6 # size 0.7 # lpf 2400
  -- 6
  harmony :: Pattern Note
  harmony = fromString $ unlines [
    "[d4,f4,a4,c5,e5] ~ ~ [c4,e4,g4,b4] [bb3,d4,f4,a4] [a3,c4,e4,g4] ~ ~",
    "[d4,f4,a5,c6] ~ [c4,e4,g4,b4] ~ ~ [a3,c4,e4,a4] ~",
    "d4 ~ a4 ~ ~ e4",
    "[d4,f4,a4,c5,e5] ~ ~ [c4,e4,g4,b4] [bb3,d4,f4,a4] [a3,c4,e4,g4] ~ ~"]
  plain = fromString $ unlines [
    "d4 ~ ~ c4 bb3 a3 ~ ~",
    "d4 ~ c4 ~ ~ a3 ~",
    "d4 ~ a4 ~ ~ e4",
    "d4 ~ ~ c4 bb3 a3 ~ ~"]
  plain2 = fromString $ unlines [
    "~ ~ d4 bb3 a3 c4 ~ ~",
    "c4 ~ d4 ~ ~ a3 ~",
    "a4 ~ d4 ~ ~ e4",
    "c4 ~ ~ d4 bb3 a3 ~ ~"]
  pad n = slow 16 $ note harmony # s "hedge_pad" # sustain 4 # gain 0.85
    # room 0.95 # size 0.85
  padS n s' = slow 16 $ note harmony # s "hedge_pad" # sustain s' # gain 0.85
    # room 0.95 # size 0.85
  padDeg = degradeBy 0.5 $ padS harmony 4
  -- 7
  pluck = slow 4 $ note "d5 ~ ~ f5 ~ a5 ~ ~" # s "pluck" # gain 0.85 # delay 0.7 # delaytime 0.375 # room 0.9 # size 0.8 # lpf 2600
  -- 9
  riser = s "hedge_noise" # sustain 4 # gain (range 0.5 0.88 $ slow 4 saw) # lpf (range 300 5000 $ slow 4 saw) # room 0.9

-- d1 / d2 — the bed and the sub. Open with these two.

-- d1: 26-second atmospheric pad, looped by slow repetition.
d1 $ bed # gain 0.88

-- d2: sub drone, D2. Long sustain, very little top end.
d2 $ drone "c3" # amp 0.25

-- Variation: thin the pad out once the set is moving.
d1 $ bed # lpf 900 # gain 0.4

-- d3 / d4 — field recordings and air.

-- d4: wind bed.
d4 air

-- occasional bird calls
-- d3 $ sometimesBy 0.5 (fast 2) birds

-- d5 — soft pulse. Starts the clock without turning it into a beat.

d5 tick

d2 $ drone "d3" # amp 0.25 -- slightly lower the drone

-- Lift it gently.
-- d5 $ tick # gain 0.38 # lpf 3200

-- Half-time feel.
-- d5 $ slow 4 $ tick

-- Drop it out again.
-- d5 silence

-- d6 — pad harmony: Dm9 → Cmaj7 → Bbmaj7 → Am7, one chord every 4 cycles.

d6 $ pad harmony

-- Open the filter slowly across the progression.
-- d6 $ pad harmony # lpf (range 500 3500 $ slow 16 sine)

-- Narrow it for the drift section.
-- d6 $ pad harmony # lpf 700 # gain 0.35

-- d7 — sparse plucked melody. Space is the instrument.

d7 $ degradeBy 0.3 pluck

-- Denser, for the bloom.
-- d7 $ degradeBy 0.15 $ slow 2 pluck

-- Thinner, for the dissolve.
-- d7 $ degradeBy 0.6 $ slow 8 pluck

-- Off.
-- d7 $ silence

-- Transitions. Eval one line at a time; the commented ones are cues.

-- xfadeIn 4 8 air

-- xfadeIn 6 8 silence

once $ slow 8 riser

a=
  [
    -- bed
    1, -- bed
    2, -- drone
    -- texture
    3, -- birds
    4, -- air
    -- pulse
    5, -- tick
    -- harmony
    6, -- pad
    -- melody
    7, -- pluck
    -- transitions
    9 -- riser
  ]

fadeSilence 16 a
