-- Grin — funk techno / the pocket, then the grid
-- 120 BPM · E dorian. Em9 | Em9 | A13 | B7#9, one chord per bar. Bed A is
-- the human pocket: a broken kick, swung sixteenths, the bass behind the
-- beat, ghost snares, a rootless clav comp. Bed B is the machine: four to
-- the floor, straight sixteenths, the same bass quantised to a pulse, no
-- ghosts and no horns. The coda brings the pocket back for a turnaround and
-- stops on the one.
--
-- Eval the setup block, then the sections in order. Section 4 hands the bed
-- over to the machine by crossfade — evaluate it as one block so the fades
-- line up. Section 5 is the breakdown; section 6 is the coda. After the
-- breakdown, play 6 straight away, or bring the grid back with 4 for a last
-- chorus and then play 6.
--
-- Gotchas: reverb size <= 0.9; `amp` is linear (prefer it to `gain`).
-- One cycle is one bar (2 s at 120 BPM).
-- gretsch is the acoustic kit: 4/5 closed hat, 6 cowbell, 13 kick,
-- 16 open-ish hat, 17 open hat (7 s — too long here), 20 snare, 21 ghost.
-- drumtraks is the machine: 1 claps, 2 cowbell, 4 closed hat, 5 open hat,
-- 6 kick, 8 rimshot, 9 snare. 909 is the 909 kick.
-- trump:2 is E5 (Tidal e6); the tight stabs are B5, E5, G5 at n 0/2/3 and a
-- sampled chord at n 9. trump:4 is a 3.2 s funk phrase at 107 BPM.
-- Pitch reminder: jvbass:0 → fs2, pluck:8 → d5, trump:2 → e6, ho:0 → ds5.
-- Mini-notation spellings: accidentals are `s`/`f` (cs4, fs2, bf3), never
-- `#`, and each chord needs its own brackets inside an alternation —
-- `<[e4,g4,b4] [a3,cs4,e4]>`, not `<e4,g4,b4 a3,cs4,e4>`. Both mistakes pass
-- the typechecker, which only sees a string, and fail when the stream ticks.
-- hedge_pad has a fixed 900 Hz LPF and a slow attack — it swells, it does not
-- stab.

setbpm 120

-- ---------------------------------------------------------------------------
-- Reused voices. Everything else is inline at its section.
-- Keep this whole block one paragraph: C-RET evaluates the paragraph at point.
-- ---------------------------------------------------------------------------
let
  -- The four-bar vamp, root position: Em9 | Em9 | A13 | B7. The pad plays the
  -- shell (root-3-5-b7); the bass owns the root and the clav fills the 9ths
  -- and 13ths in between, an octave under the pad.
  hA :: Pattern Note
  hA = "<[e4,g4,b4,d5] [e4,g4,b4,d5] [a3,cs4,e4,g4] [b3,ds4,fs4,a4]>"
  -- Rootless comping: 3-5-b7-9, voiced so the top moves F# -> E -> C.
  hClav :: Pattern Note
  hClav = "<[g4,b4,d5,fs5] [g4,b4,d5,fs5] [cs4,g4,b4,e5] [ds4,fs4,a4,c5]>"
  -- The coda's turnaround: the same first two bars, then Bb13 and B7#9. The
  -- bass climbs A -> Bb -> B chromatically underneath.
  hCoda :: Pattern Note
  hCoda = "<[g4,b4,d5,fs5] [cs4,g4,b4,e5] [d4,f4,af4,c5] [ds4,fs4,a4,c5]>"

-- 1. Bed A — the pocket. Kick on 1, 2& and 4; closed hats in swung
--    sixteenths; snare on 2 and 4 with ghosts between; the bass and the clav
--    pushed late by the swing; a rootless clav comp on the "and" of each
--    beat. The pad changes chord every bar, so it cannot be `slow`ed: over
--    A13 its D would sit against the C#, and over B7 against the D#. It is an
--    octave up so it floats above the comp instead of muddying it.
--
--    The bed builds itself: every stream fades from silence, one reaching
--    full gain four bars after the next — bass 4, kick 8, hats 12, snare 16,
--    ghosts 20, clav 24, pad 28. Full bed by bar 28 (~56 s).
xfadeIn 1 4 $ swing16 $ s "jvbass" # n 0
  # speedAt "fs2" "<[e2 ~ e2 e3 ~ e2 ~ g2 a2 ~ e2 ~ b2 ~ a2 g2] [e2 ~ e2 e3 ~ e2 ~ d3 ~ e3 ~ b2 a2 ~ g2 ~] [a2 ~ a2 a3 ~ a2 ~ cs3 e3 ~ a2 ~ g2 e2 a2 cs3] [b2 ~ b2 b3 ~ b2 ~ ds3 fs3 ~ b2 ~ a2 fs2 ~ ds2]>"
  # sustain 0.16 # release 0.06 # lpf 900 # lpq 0.22
  # shape 0.18 # room 0.1 # size 0.24 # amp 0.95
xfadeIn 2 8 $ s "<[gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~] [gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~] [gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~] [gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ gretsch:13]>"
  # amp 1 # room 0.04 # size 0.12
xfadeIn 3 12 $ swing16 $ s "gretsch:5*16"
  # amp "0.5 0.24 0.36 0.24 0.46 0.24 0.34 0.24 0.5 0.24 0.36 0.24 0.46 0.24 0.34 0.26"
  # hpf 350 # room 0.06 # size 0.16
xfadeIn 4 16 $ s "~ ~ ~ ~ gretsch:20 ~ ~ ~ ~ ~ ~ ~ gretsch:20 ~ ~ ~"
  # amp 0.8 # room 0.12 # size 0.24
xfadeIn 5 20 $ swing16 $ s "~ ~ gretsch:21 ~ ~ ~ gretsch:21 ~ ~ ~ gretsch:21 ~ ~ ~ gretsch:21 ~"
  # amp 0.25 # hpf 250 # room 0.1 # size 0.2
xfadeIn 6 24 $ swing16 $ struct "~ ~ t ~ ~ ~ t ~ ~ ~ t ~ ~ ~ t ~"
  $ s "pluck" # n 8
  # speedAt "d5" hClav
  # sustain 0.16 # release 0.1 # lpf 2200 # lpq 0.25
  # room 0.28 # size 0.46 # amp 0.42
xfadeIn 7 28 $ s "hedge_pad" # n (hA |+ 12)
  # sustain 1.6 # amp 0.36 # room 0.45 # size 0.58

-- 2. The one — the horns enter on the phrase and a shout lands on the one.
--    Three tight stabs (E, G, B) answer the clav; the sampled chord marks the
--    top of the phrase. After the shout, the cowbell takes its place.
d8 $ swing16 $ s "trump" # n 2
  # speedAt "e6" "<[e6 ~ ~ g6 ~ ~ b5 ~ ~ ~ e6 ~ ~ ~ ~ ~] [~ ~ g6 ~ ~ b5 ~ ~ e6 ~ ~ ~ ~ ~ ~ ~] [cs6 ~ ~ e6 ~ ~ g6 ~ ~ ~ e6 ~ ~ ~ ~ ~] [ds6 ~ ~ fs6 ~ ~ a6 ~ ~ ~ fs6 ~ ~ ds6 ~ c6]>"
  # sustain 0.14 # release 0.08 # lpf 3600 # lpq 0.3
  # hpf 220 # room 0.3 # size 0.5 # amp 0.5 # pan 0.56
d9 $ slow 4 $ s "trump" # n 9
  # speedAt "e6" "e6"
  # sustain 0.5 # release 0.25 # lpf 3200 # lpq 0.3
  # room 0.35 # size 0.55 # amp 0.42
d10 $ slow 4 $ s "ho" # n 0
  # speedAt "ds5" "e5" # amp 0.75 # room 0.25 # size 0.4

-- d10 · then the cowbell (not-metal) takes over from the shout
d10 $ s "~ ~ gretsch:6 ~ ~ ~ gretsch:6 ~ ~ ~ gretsch:6 ~ ~ ~ gretsch:6 ~"
  # amp 0.36 # pan 0.36 # room 0.14 # size 0.26

-- 3. Hook — the clav opens: filter off, a busier syncopated line. The hats
--    answer with the open-ish hat on the offbeats, left straight — a hair
--    ahead of the swung sixteenths, the first hint of the grid. The horns
--    keep the phrase from section 2. This is the peak of bed A.
d6 $ swing16 $ struct "t ~ ~ t ~ ~ t ~ ~ t ~ t ~ ~ t ~"
  $ s "pluck" # n 8
  # speedAt "d5" hClav
  # sustain 0.18 # release 0.1 # lpf 4200 # lpq 0.3
  # room 0.3 # size 0.5 # amp 0.48
d3 $ s "~ gretsch:16 ~ gretsch:16 ~ gretsch:16 ~ gretsch:16"
  # amp 0.3 # hpf 400 # room 0.12 # size 0.24

-- the trump in the foreground is d8 and will be muted with high
-- voices in bed b
-- xfadeIn 8 16 silence

-- 4. Bed B — the grid. Same sixteen bars, recut: four to the floor, straight
--    sixteenths, the bass quantised to a root/octave pulse, a machine clav on
--    the eighths, a rimshot on the offbeats. The pad drops to one rootless
--    voicing — B, F#, A — that sits under all four bars. The horns fade out:
--    the machine has no breath. Evaluate this whole block at once: the
--    percussion and clav crossfade in two bars, the bass and pad in four, so
--    the pocket keeps its pulse while the grid takes over.

-- high voices
fadeMulti 8
  [ (6, struct "t ~ t ~ t ~ t ~ t ~ t ~ t ~ t ~"
      $ s "pluck" # n 8
      # speedAt "d5" hClav
      # sustain 0.11 # release 0.06 # lpf 1800 # lpq 0.2
      # room 0.18 # size 0.34 # amp 0.34)
  , (8, silence) -- trump
  , (9, silence) -- trump
  , (10, s "~ ~ drumtraks:2 ~ ~ ~ drumtraks:2 ~ ~ ~ drumtraks:2 ~ ~ ~ drumtraks:2 ~"
      # amp 0.3 # pan 0.36 # room 0.08 # size 0.18)
  ]

-- all the rest
fadeMulti 32
  [ (2, s "909*4" # amp 1 # lpf 320 # room 0.04 # size 0.1)
  , (3, s "drumtraks:4*16"
      # amp "0.48 0.28 0.4 0.28 0.46 0.28 0.4 0.28 0.48 0.28 0.4 0.28 0.46 0.28 0.4 0.3"
      # hpf 300 # room 0.05 # size 0.14)
  , (4, s "~ ~ ~ ~ drumtraks:9 ~ ~ ~ ~ ~ ~ ~ drumtraks:9 ~ ~ ~"
      # amp 0.72 # room 0.1 # size 0.2)
  , (5, s "~ ~ drumtraks:8 ~ ~ ~ drumtraks:8 ~ ~ ~ drumtraks:8 ~ ~ ~ drumtraks:8 ~"
      # amp 0.28 # hpf 400 # room 0.08 # size 0.16)
  ]
fadeMulti 64
  [ (1, s "jvbass" # n 0
      # speedAt "fs2" "<[e2 e2 e3 e2 e2 e2 e3 e2 e2 e2 e3 e2 e2 e2 e3 e2] [e2 e2 e3 e2 e2 e2 e3 e2 e2 e2 e3 e2 e2 e2 e3 e2] [a2 a2 a3 a2 a2 a2 a3 a2 a2 a2 a3 a2 a2 a2 a3 a2] [b2 b2 b3 b2 b2 b2 b3 b2 b2 b2 b3 b2 b2 b2 b3 b2]>"
      # amp "0.95 0.55 0.75 0.55 0.9 0.55 0.75 0.55 0.95 0.55 0.75 0.55 0.9 0.55 0.75 0.6"
      # sustain 0.13 # release 0.05 # lpf 1000 # lpq 0.2
      # shape 0.24 # room 0.08 # size 0.2)
  , (7, slow 4 $ s "hedge_pad" # n "<b4,fs5,a5>"
      # sustain 2 # amp 0.38 # room 0.45 # size 0.6)
  ]

-- 5. Breakdown — the grid thins to the kick, a bass pedal, the pad and the
--    horn. The trumpet phrase (trump:4, a 107 BPM funk line) is dropped a
--    semitone so its notes (C# D E G) sit in E dorian, and it enters on the
--    and of 1 — half a beat behind the kick, so the pocket pulls against the
--    grid. The shout answers underneath. Then the kick doubles into a machine
--    fill in the fourth bar.
fadeSilence 32 [3, 4, 5, 6, 10]

xfadeIn 1 4 $ slow 4 $ s "jvbass" # n 0
  # speedAt "fs2" "e2"
  # sustain 6 # release 2 # lpf 420 # lpq 0.15
  # room 0.5 # size 0.7 # amp 0.85

d8 $ rotR 0.125 $ slow 2 $ s "trump" # n 4
  # speedAt "d5" "cs5"
  # sustain 3.4 # release 0.2 # lpf 3400 # lpq 0.3
  # room 0.45 # size 0.62 # amp 0.6

d10 $ slow 4 $ s "ho" # n 2 -- not loud at all
  # speedAt "ds5" "e5" # amp 0.7 # room 0.3 # size 0.45

-- the beat you have been waiting for. Kick doubling into sixteenths
-- at the end of the fourth bar
d2 $ s "<909*4 909*4 909*4 [909*4 909*8]>"
  # amp 1 # lpf 320 # room 0.04 # size 0.1

-- 6. Coda — the pocket returns for one turnaround: Em9 | A13 | Bb13 | B7#9.
--    The bass climbs A -> Bb -> B, the clav, the horns and the cowbell change
--    with it, and the kit comes back with them. Play it twice, then stop on
--    the one and let the pad hold Em9.

-- high voices
fadeMulti 8
  [ (6, swing16 $ struct "t ~ ~ t ~ ~ t ~ ~ t ~ t ~ ~ t ~"
      $ s "pluck" # n 8
      # speedAt "d5" hCoda
      # sustain 0.16 # release 0.1 # lpf 2600 # lpq 0.25
      # room 0.3 # size 0.48 # amp 0.46)
  , (7, s "hedge_pad" # n (hCoda |+ 12)
      # sustain 1.8 # amp 0.38 # room 0.45 # size 0.58)
  , (8, swing16 $ s "trump" # n 2
      # speedAt "e6" "<[e6 ~ ~ g6 ~ ~ b5 ~ ~ ~ e6 ~ ~ ~ ~ ~] [cs6 ~ ~ e6 ~ ~ g6 ~ ~ ~ e6 ~ ~ ~ ~ ~] [d6 ~ ~ f6 ~ ~ af6 ~ ~ g6 ~ f6 ~ ~ ~ ~] [ds6 ~ ~ fs6 ~ ~ a6 ~ ~ ~ fs6 ~ ~ ds6 ~ c6]>"
      # sustain 0.14 # release 0.08 # lpf 3600 # lpq 0.3
      # hpf 220 # room 0.3 # size 0.5 # amp 0.5 # pan 0.56)
  , (10, s "~ ~ gretsch:6 ~ ~ ~ gretsch:6 ~ ~ ~ gretsch:6 ~ ~ ~ gretsch:6 ~"
      # amp 0.32 # pan 0.36 # room 0.14 # size 0.26)
  ]

-- all the rest. Slightly weird before adding this one
fadeMulti 32
  [ (1, swing16 $ s "jvbass" # n 0
      # speedAt "fs2" "<[e2 ~ e2 e3 ~ e2 ~ g2 a2 ~ e2 ~ b2 ~ a2 g2] [a2 ~ a2 a3 ~ a2 ~ cs3 e3 ~ a2 ~ g2 e2 a2 cs3] [bf2 ~ bf2 bf3 ~ bf2 ~ d3 f3 ~ bf2 ~ af2 f2 ~ d3] [b2 ~ b2 b3 ~ b2 ~ ds3 fs3 ~ b2 ~ a2 fs2 ~ ds2]>"
      # sustain 0.16 # release 0.06 # lpf 1100 # lpq 0.22
      # shape 0.2 # room 0.1 # size 0.24 # amp 0.95)
  , (2, s "<[gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~] [gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~] [gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~] [gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~ ~ gretsch:13]>"
      # amp 1 # room 0.04 # size 0.12)
  , (3, swing16 $ s "gretsch:5*16"
      # amp "0.5 0.24 0.36 0.24 0.46 0.24 0.34 0.24 0.5 0.24 0.36 0.24 0.46 0.24 0.34 0.26"
      # hpf 350 # room 0.06 # size 0.16)
  , (4, s "~ ~ ~ ~ gretsch:20 ~ ~ ~ ~ ~ ~ ~ gretsch:20 ~ ~ ~"
      # amp 0.8 # room 0.12 # size 0.24)
  , (5, swing16 $ s "~ ~ gretsch:21 ~ ~ ~ gretsch:21 ~ ~ ~ gretsch:21 ~ ~ ~ gretsch:21 ~"
      # amp 0.25 # hpf 250 # room 0.1 # size 0.2)
  ]

-- it could finish with the following

-- evaluate this offbeat: the band stops on the one; the pad holds Em9
fadeSilence 0.5 [1, 2, 3, 4, 5, 6, 8, 10]
xfadeIn 7 1 $ s "hedge_pad" # n "<g5,b5,d6,fs6>"
  # sustain 4 # amp 0.42 # room 0.6 # size 0.78

xfadeIn 7 16 silence

-- or continue...

