-- Salem — clean, smooth reading of a high, fast-modulating counterpoint.
-- 132 BPM · 4/4 · G minor (G A Bb C D Eb F). One cycle is one score bar;
-- 60 steps/bar (1/15 quarter), ten score bars. The long `_` strings are the
-- literal MIDI grids from `scripts/midi-reader --steps 60 --bars 10`; the
-- `t`/`~` strings are its onsets from `--gates --bars 10`. `--bars 10` keeps
-- empty bars as `~` lines, so each `cat` stays aligned with the MIDI.
-- No waveshaping and no modulation
-- overrides: breath and bow behaviour stay in the SynthDefs. Kick and hat keep
-- a steady pulse; the sub reads c:'s written onsets, and all four voices read
-- their own lines. Sections: entry, drift, cut, return.
-- Source: agents/making_of/scores/salem.midi (LilyPond 2.24.4, title "Test",
-- four voices a:/b:/c:/d:). Gotchas: notes/learning/gotchas.md.

glideBpm 132 60

-- ---------------------------------------------------------------------------
-- Scores, onset gates and voices. Keep this whole block one paragraph.
-- a: bowed string, b: hum, c: horn, d: moog bass. Gates come from the same
-- note-ons as the scores, so the sub cannot drift from the counterpoint.
-- ---------------------------------------------------------------------------
let
  aScore :: Pattern Note
  aScore = cat [
    "g7 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ as7 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ~ g7 _ _ _ _ _ _ _ _ _ _ _ _ _ _",
