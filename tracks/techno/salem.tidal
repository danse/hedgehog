  --
  -- a: high bowed string. Slow attack and a long tail keep the written g7/as7
  -- smooth; no tremolo or vibrato overrides.
  topVoice :: Pattern Note -> ControlPattern
  topVoice p = note p # s "hedge_strings" # legato 0.96
    # lpf 2000 # attack 0.25 # release 1.2
    # pan 0.35 # room 0.5 # size 0.65 # amp 0.6
  --
  -- b: soft hum, sitting just under the top line.
  midVoice :: Pattern Note -> ControlPattern
  midVoice p = note p # s "hedge_hum" # legato 0.96
    # lpf 1800 # room 0.45 # size 0.6 # pan (-0.25) # amp 0.65
  --
  -- c: horn, further back with a gentle envelope.
  horn :: Pattern Note -> ControlPattern
  horn p = note p # s "hedge_horn" # legato 0.95
    # attack 0.12 # release 0.7 # lpf 1400
    # pan 0.15 # room 0.42 # size 0.6 # amp 0.65
  --
  -- d: moog bass, tuned from moog:1's c4 base. Low Q, no drive.
  bass :: Pattern Note -> ControlPattern
  bass p = speedAt "c4" p # s "moog:1" # legato 0.85
    # sustain 0.3 # release 0.15 # lpf 450 # lpq 0.3
    # room 0.06 # size 0.16 # amp 1.2
  --
  -- Engine: a plain kick and offbeat hat; the sub follows c:'s written onsets.
  kickPat :: ControlPattern
  kickPat = s "909*4" # amp 1 # lpf 300 # room 0.04 # size 0.1
  subPat :: ControlPattern
  subPat = struct cGates $ s "808bd"
    # amp 0.9 # lpf 220 # room 0.05 # size 0.14
  hatPat :: ControlPattern
  hatPat = s "~ hh:0 ~ hh:0"
    # amp 0.28 # hpf 6000 # room 0.12 # size 0.24 # pan 0.35
  --

-- 1. Entry. The beat is plain from the start; the written rests make the
--    stagger. Evaluate each clutch line, or the whole paragraph, as one block.
multi clutchIn 8 [
  (1, kickPat),
  (2, subPat),
  (3, hatPat),
  (4, bass dScore),
  (5, horn cScore),
  (6, midVoice bScore),
  (7, topVoice aScore)]


-- 2. Drift. Open the top two voices; the beat stays put.
clutchIn 7 4 $ topVoice aScore # room 0.6 # size 0.8 # lpf 2400
clutchIn 5 4 $ horn cScore # room 0.55 # size 0.75

-- 3. Cut. Drop the sub and bass; kick, hat and upper lines carry the bar.
clutchIn 2 2 silence
clutchIn 4 2 silence

-- 4. Return. Bring the low end back a touch fuller.
clutchIn 2 4 subPat
clutchIn 4 4 $ bass dScore # lpf 520


multi clutchIn 64 $ (, silence) <$> [1,2,3,4,5,6,7]
