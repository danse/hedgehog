-- Atrium — house / one loop, two rooms
-- 124 BPM · A minor. Am9 | Fmaj9 | Cmaj9 | G6/9, one chord per bar:
-- i–VI–III–VII. The track walks that loop three times with the same band. It
-- opens with kick, hats, bass and pad; adds clap, stabs and open hat; lets the
-- hook in; breaks; drops; then builds (not breaks again) into the second peak
-- while the whole loop moves up a fourth — Dm9 | Bbmaj9 | Fmaj9 | C6/9 — for
-- the second half (sections 7-10), before the outro resolves it back to Am9.
-- The drums never change key and the hook is the same shape a fourth up, so
-- the lift is one decision, not a new tune. Deep (8) can be stretched with an
-- optional half-time passage (8b).
--
-- Eval the setup block, then the sections in order. Section 5 is the break and
-- 6 its drop; evaluate them as two paragraphs, a bar or two apart, so the
-- fades line up. Section 9 is a build, so 10 lands on top of a band that never
-- left. 8b is optional: evaluate it after 8 for an eight-bar half-time passage,
-- or skip it and let 8 keep running. 11 and 12 are the outro; `hush` after the
-- last chord has rung out.
--
-- dN is a seat in the band, not a pattern: 1 kick, 2 closed hats, 3 bass,
-- 4 pad, 5 clap, 6 stabs, 7 open hat, 8 rim, 9 lead, 10 vocal / air. A section
-- replaces a seat with xfadeIn, fadeMulti or fadeSilence, so the numbers keep
-- their meaning all night.
--
-- Bar counts are in the section comments; the whole thing is ~280 bars, about
-- 9:00 at 124 BPM — ~288 bars and 9:15 if you play 8b — longer if you let a
-- section run.
--
-- Gotchas: reverb size <= 0.9; `amp` is linear (prefer it to `gain`).
-- Accidentals in mini-notation are `s`/`f` (cs4, bf3), never `#`; every chord
-- in an alternation needs its own brackets — `<[a4,c5,e5] [f4,a4,c5]>`.
-- The pad is juno:8, a 1.5 s Juno release tone at C5 with only an octave
-- partial, so it can take any chord tone. Slowed to a3-b4 each note blooms
-- for most of a bar and hands over to the next chord — `speedAt "c5"` keeps
-- it in tune. One cycle is one bar (~1.94 s at 124 BPM).
-- house:0 kick, 1 cowbell, 3 closed hat, 4 open hat, 5/6 perc, 7 snare.
-- cp:0 is the clap, rs the rimshot. jvbass:0 is the sub, pluck:8 the comp,
-- moog:2 the lead; speedAt keeps them in their own samples.

glideBpm 124 8

-- ---------------------------------------------------------------------------
-- Reused voices. Everything else is inline at its section.
-- The four-bar loop, the comp, the bass, the hook and the kick phrase are
-- named once; the harmonic ones move by `|+ 5` in the turn. Keep this whole
-- block one paragraph: C-RET evaluates the paragraph at point.
-- ---------------------------------------------------------------------------
let
  -- The loop, root position, one chord per bar. The pad plays these notes as
  -- written (a3-b4); the rootless voicings below sit above them.
  hA :: Pattern Note
  hA = chordAt "<a3 f3 c3 g3>" "<min9 maj9 maj9 sixNine>"
  -- The pad voice: juno:8 bloomed once per bar, tuned by speedAt. Sections
  -- pass their own notes (`hA`, `hA |+ 5`, a final chord) and override release
  -- or room where they differ; change `amp` here to rebalance every pad.
  pad :: Pattern Note -> ControlPattern
  pad p = s "juno" # n 8 # speedAt "c5" p
        # sustain 1.6 # release 0.9 # hpf 140
        # room 0.5 # size 0.66 # amp 0.2
  -- Four-bar kick phrase. The pulse stays square, but the third bar doubles on
  -- beat four and the fourth drops it, so the phrase leans into the next one
  -- instead of ticking the same four hits all night.
  kick :: Pattern String
  kick = "<house:0*4 house:0*4 [house:0 house:0 house:0 [house:0 house:0]] [house:0 house:0 house:0 ~]>"
  -- Rootless stabs: 3-5-7-9 over each chord, written high so the comp cuts
  -- through the pad instead of muddying it.
  stabs :: Pattern Note
  stabs = "<[c5,e5,g5,b5] [a4,c5,e5,g5] [e5,g5,b5,d6] [b4,d5,e5,a5]>"
  -- The bass on the offbeats, octave on the fourth eighth of each bar.
  bassA :: Pattern Note
  bassA = "<[~ a2 ~ a2 ~ a2 ~ a3] [~ f2 ~ f2 ~ f2 ~ f3] [~ c3 ~ c3 ~ c3 ~ c4] [~ g2 ~ g2 ~ g2 ~ g3]>"
  -- The hook: one note per offbeat, four bars. It outlines the chord of the
  -- bar and leaves the strong beats empty, so it sits over the comp.
  hook :: Pattern Note
  hook = "<[a4 c5 ~ ~ e5 ~ d5 c5] [a4 ~ c5 ~ a4 ~ ~ ~] [g4 ~ a4 ~ c5 ~ e5 ~] [d5 ~ b4 ~ g4 ~ ~ ~]>"

-- 1. Doors — 32 bars. The room fills: kick, then hats, then the sub, then the
--    pad. All four are cued together with different fade lengths, so the build
--    is one gesture: full bed at bar 28. The kick is filtered down to a thud;
--    section 2 opens it. The pad is held below the shared level here, so it
--    arrives under the fade rather than on top of it.
xfadeIn 1 4 $ s kick
  # amp "0.9 0.85 0.88 0.84" # lpf 240 # room 0.04 # size 0.12
xfadeIn 2 12 $ s "house:3*16"
  # amp "0.5 0.2 0.32 0.2 0.44 0.2 0.3 0.2 0.5 0.2 0.32 0.2 0.44 0.2 0.3 0.22"
  # hpf 520 # room 0.06 # size 0.16
xfadeIn 3 20 $ speedAt "fs2" bassA
  # s "jvbass" # n 0
  # sustain 0.2 # release 0.08 # lpf 620 # lpq 0.22
  # shape 0.2 # room 0.08 # size 0.2 # amp 0.95
xfadeIn 4 28 $ pad hA

-- 2. Room — 32 bars. The backbeat and the comp arrive: clap on 2 and 4, the
--    stabs on every offbeat, the open hat on every offbeat under them. The
--    kick loses the blanket.
xfadeIn 1 8 $ s kick
  # amp "1 0.94 0.97 0.93" # lpf 380 # room 0.04 # size 0.12
xfadeIn 5 8 $ s "~ ~ cp:0 ~ ~ ~ cp:0 ~"
  # amp 0.55 # room 0.22 # size 0.34
xfadeIn 6 16 $ struct "~ t ~ t t ~ ~ t"
  $ s "pluck" # n 8
  # speedAt "d5" stabs
  # sustain 0.14 # release 0.1 # lpf 2400 # lpq 0.3
  # room 0.3 # size 0.5 # amp 0.42 # pan 0.42
xfadeIn 7 24 $ s "~ house:4 ~ house:4 ~ house:4 ~ house:4"
  # amp 0.34 # hpf 300 # room 0.12 # size 0.24 # pan 0.56

-- 3. Hook — 32 bars. The rim tick and the lead enter, the lead still behind a
--    filter: a shape, not yet a tune. The hats stay 16ths; the open hat is
--    already there.
d8 $ s "rs rs rs rs ~ ~ rs ~ ~ ~ rs ~ ~ ~ rs ~"
  # amp 0.22 # hpf 500 # room 0.1 # size 0.2 # pan 0.34
d9 . degrade $ speedAt "c4" hook
  # s "moog" # n 2
  # sustain 0.26 # release 0.2 # lpf 900 # lpq 0.35
  # room 0.35 # size 0.55 # amp 0.42 # pan 0.6

-- 4. Peak one — 24 bars. The filter opens on the lead and the comp, the kick
--    is unfiltered, and a shout lands on the one every eight bars. Nothing new
--    enters: the same six voices get louder and brighter.
xfadeIn 1 2 $ s kick
  # amp "1.05 0.98 1.02 0.99" # room 0.04 # size 0.1
xfadeIn 10 2 $ slow 8 $ s "ho" # n 0
  # speedAt "ds5" "a4"
  # sustain 0.4 # release 0.3 # room 0.3 # size 0.5 # amp 0.5
xfadeIn 6 4 $ struct "~ t ~ t ~ ~ t t"
  $ s "pluck" # n 8
  # speedAt "d5" stabs
  # sustain 0.16 # release 0.1 # lpf 3600 # lpq 0.3
  # room 0.32 # size 0.52 # amp 0.46 # pan 0.42
xfadeIn 9 4 $ speedAt "c4" hook
  # s "moog" # n 2
  # sustain 0.28 # release 0.2 # lpf 3000 # lpq 0.35
  # room 0.32 # size 0.5 # amp 0.46 # pan 0.6

-- 5. Break — 8 bars. Everything but the bass and the pad goes; the bass drops
--    to an A pedal and the pad holds the loop. A noise riser takes the place
--    of the shout and sweeps the eight bars. Evaluate 6 on the last bar.
xfadeIn 3 4 $ slow 4 $ s "jvbass" # n 0
  # speedAt "fs2" "a2"
  # sustain 6 # release 2 # lpf 420 # lpq 0.15
  # room 0.5 # size 0.7 # amp 0.8
xfadeIn 10 8 $ s "hedge_noise"
  # sustain 8 # lpf (range 400 5000 $ slow 8 sine)
  # room 0.4 # size 0.6 # amp 0.28
fadeSilence 16 [1, 2, 5, 6, 7, 8, 9]

-- 6. Drop — 32 bars. This is the first peak again, a fourth down from
--    where the track ends. The band comes back in two passes: drums
--    over two bars, everything else over four, so the kick lands
--    before the harmony does.
--    
fadeMulti 2
  [ (1, s kick # amp "1.05 0.98 1.02 0.99" # room 0.04 # size 0.1)
  , (5, s "~ ~ cp:0 ~ ~ ~ cp:0 ~" # amp 0.55 # room 0.22 # size 0.34)
  , (7, s "~ house:4 ~ house:4 ~ house:4 ~ house:4"
      # amp 0.34 # hpf 300 # room 0.12 # size 0.24 # pan 0.56)
  , (8, s "~ ~ rs ~ ~ ~ rs ~ ~ ~ rs ~ ~ ~ rs ~"
      # amp 0.22 # hpf 500 # room 0.1 # size 0.2 # pan 0.34)
  ]
xfadeIn 10 2 $ slow 8 $ s "ho" # n 0
  # speedAt "ds5" "a4"
  # sustain 0.4 # release 0.3 # room 0.3 # size 0.5 # amp 0.5
fadeMulti 4
  [ (2, every 8 (fast 2) $ s "house:3*16"
      # amp "0.5 0.2 0.32 0.2 0.44 0.2 0.3 0.2 0.5 0.2 0.32 0.2 0.44 0.2 0.3 0.22"
      # hpf 520 # room 0.06 # size 0.16)
  , (3, speedAt "fs2" bassA
      # s "jvbass" # n 0
      # sustain 0.2 # release 0.08 # lpf 720 # lpq 0.22
      # shape 0.2 # room 0.08 # size 0.2 # amp 0.95)
  , (6, struct "~ t ~ t ~ t ~ t"
      $ s "pluck" # n 8
      # speedAt "d5" stabs
      # sustain 0.16 # release 0.1 # lpf 3600 # lpq 0.3
      # room 0.32 # size 0.52 # amp 0.46 # pan 0.42)
  , (9, speedAt "c4" hook
      # s "moog" # n 2
      # sustain 0.28 # release 0.2 # lpf 3000 # lpq 0.35
      # room 0.32 # size 0.5 # amp 0.46 # pan 0.6)
  ]

-- 7. Turn — 16 bars. The whole loop moves up a fourth: pad, bass, comp and
--    hook are the same patterns with `|+ 5`. The drums stay exactly where they
--    were, so the key change is the only new information. Two-bar fades, so the
--    old and new chords overlap for one bar and hand over.
xfadeIn 4 2 $ pad (hA |+ 5)
xfadeIn 3 2 $ speedAt "fs2" (bassA |+ 5)
  # s "jvbass" # n 0
  # sustain 0.2 # release 0.08 # lpf 720 # lpq 0.22
  # shape 0.2 # room 0.08 # size 0.2 # amp 0.95
xfadeIn 6 2 $ struct "~ t ~ t ~ t ~ t"
  $ s "pluck" # n 8
  # speedAt "d5" (stabs |+ 5)
  # sustain 0.16 # release 0.1 # lpf 3600 # lpq 0.3
  # room 0.32 # size 0.52 # amp 0.46 # pan 0.42
xfadeIn 9 2 $ speedAt "c4" (hook |+ 5)
  # s "moog" # n 2
  # sustain 0.28 # release 0.2 # lpf 3000 # lpq 0.35
  # room 0.32 # size 0.5 # amp 0.46 # pan 0.6

-- 8. Deep — 32 bars. The dub room: hats, open hat and lead go, the comp drops
--    to one stab every two bars and the clap goes soft. Kick, sub, rim and pad
--    keep the pulse. Let it run; this is where the second half breathes.
fadeSilence 8 [2, 7, 9]
xfadeIn 5 8 $ s "~ ~ cp:0 ~ ~ ~ ~ ~"
  # amp 0.4 # room 0.3 # size 0.44
xfadeIn 6 8 $ slow 2 $ struct "~ t ~ ~ ~ t ~ ~"
  $ s "pluck" # n 8
  # speedAt "d5" (stabs |+ 5)
  # sustain 0.3 # release 0.3 # lpf 1200 # lpq 0.28
  # room 0.55 # size 0.72 # amp 0.4 # pan 0.42

-- 8b. Deeper, half-time — 8 bars (optional). Evaluate this when 8 has said
--     enough, or skip it and let 8 keep running. The kick drops to beats 1 and
--     3 with a two-hit pickup at the end of every four bars, the clap moves
--     from 2 to 3 (a one-drop) and the rim leaves, so the room gets heavier
--     without getting busier; bass, pad and the sparse comp stay. Section 9
--     puts the kick and rim back on straight time.
xfadeIn 1 4
  $ s "<[house:0 ~ house:0 ~] [house:0 ~ house:0 ~] [house:0 ~ house:0 ~] [house:0 ~ house:0 [house:0 house:0]]>"
  # amp 0.95 # lpf 320 # room 0.06 # size 0.16
xfadeIn 5 4 $ s "~ ~ ~ ~ cp:0 ~ ~ ~"
  # amp 0.42 # room 0.34 # size 0.5
xfadeIn 8 4 silence

-- 9. Lift — 16 bars. The second approach is not a break: nobody leaves, and
--    the build happens on top of the band. Hats return and double to 32nds,
--    the clap rolls into the last bar of every four, the comp's filter opens
--    across the sixteen bars but only to 2.2 kHz and a voice climbs through the
--    D-minor chord. The lead and the open hat are held back, so section 10
--    arrives by addition — the first peak came after subtraction, this one
--    after pressure. The kick and rim are set outright rather than faded: skip
--    8b and this is a no-op, play it and they snap back to straight time.
d1 $ s kick
  # amp "1.05 0.98 1.02 0.99" # room 0.04 # size 0.1
d8 $ s "~ ~ rs ~ ~ ~ rs ~ ~ ~ rs ~ ~ ~ rs ~"
  # amp 0.22 # hpf 500 # room 0.1 # size 0.2 # pan 0.34
xfadeIn 5 4 $ s "<[~ cp:0 ~ cp:0] [~ cp:0 ~ cp:0] [~ cp:0 ~ cp:0] [~ cp:0 ~ [cp:0 cp:0 cp:0 cp:0]]>"
  # amp (range 0.4 0.6 $ slow 16 saw) # room 0.24 # size 0.36
xfadeIn 10 4 $ slow 4 $ s "ho" # n 0
  # speedAt "ds5" "<d4 f4 a4 d5>"
  # sustain 0.5 # release 0.4 # room 0.35 # size 0.55 # amp 0.42
xfadeIn 2 8 $ s "<house:3*16 house:3*16 house:3*16 house:3*32>"
  # amp (range 0.2 0.45 $ slow 16 saw)
  # hpf 520 # room 0.06 # size 0.16
xfadeIn 6 8 $ struct "t ~ ~ t ~ t ~ t"
  $ s "pluck" # n 8
  # speedAt "d5" (stabs |+ 5)
  # sustain 0.16 # release 0.1
  # lpf (range 700 2200 $ slow 16 saw) # lpq 0.3
  # room 0.32 # size 0.52 # amp 0.46 # pan 0.42

-- 10. Peak two — 32 bars. The lift tops out: the comp's filter snaps open, the
--     open hat returns and the lead enters with the hook a fourth up. Kick,
--     sub and pad never stopped, so nothing is rebuilt — the peak is three
--     arrivals, not a second drop. Tempo lifts two beats over thirty bars.
glideBpm 126 30
xfadeIn 2 1 $ every 8 (fast 2) $ s "house:3*16"
  # amp "0.5 0.2 0.32 0.2 0.44 0.2 0.3 0.2 0.5 0.2 0.32 0.2 0.44 0.2 0.3 0.22"
  # hpf 520 # room 0.06 # size 0.16
xfadeIn 5 1 $ s "~ ~ cp:0 ~ ~ ~ cp:0 ~"
  # amp 0.55 # room 0.22 # size 0.34
xfadeIn 6 1 $ struct "~ t ~ t ~ t ~ t"
  $ s "pluck" # n 8
  # speedAt "d5" (stabs |+ 5)
  # sustain 0.16 # release 0.1 # lpf 3600 # lpq 0.3
  # room 0.32 # size 0.52 # amp 0.46 # pan 0.42
xfadeIn 7 2 $ s "~ house:4 ~ house:4 ~ house:4 ~ house:4"
  # amp 0.34 # hpf 300 # room 0.12 # size 0.24 # pan 0.56
xfadeIn 9 2 $ speedAt "c4" (hook |+ 5)
  # s "moog" # n 2
  # sustain 0.28 # release 0.2 # lpf 3000 # lpq 0.35
  # room 0.32 # size 0.5 # amp 0.46 # pan 0.6
xfadeIn 10 2 $ slow 8 $ s "ho" # n 0
  # speedAt "ds5" "a4"
  # sustain 0.4 # release 0.3 # room 0.3 # size 0.5 # amp 0.5

-- 11. Outro — 16 bars. The loop comes back down to A minor: pad, sub, comp and
--     kick. Everything melodic goes over eight bars, the tempo settles, and
--     the kick keeps the room open under the pad.
glideBpm 124 30
fadeSilence 8 [2, 5, 7, 8, 9, 10]
xfadeIn 4 2 $ pad hA
  # release 1.2 # room 0.55 # size 0.7
xfadeIn 3 2 $ speedAt "fs2" bassA
  # s "jvbass" # n 0
  # sustain 0.2 # release 0.08 # lpf 620 # lpq 0.22
  # shape 0.2 # room 0.12 # size 0.26 # amp 0.9
xfadeIn 6 2 $ struct "~ t ~ t ~ t ~ t"
  $ s "pluck" # n 8
  # speedAt "d5" stabs
  # sustain 0.2 # release 0.2 # lpf 1400 # lpq 0.28
  # room 0.42 # size 0.62 # amp 0.36 # pan 0.42

-- 12. End — 8 bars. The band leaves; the pad becomes one Am9, re-blooming
--     every two bars, and the kick goes with it. `hush` after the chord has
--     rung out.
fadeSilence 2 [1, 3, 6]
xfadeIn 4 2 $ slow 2 $ pad "[a3,c4,e4,g4,b4]"
  # sustain 3.4 # release 1.6 # room 0.62 # size 0.8
fadeSilence 8 [4]

-- `hush` after the last chord
hush
