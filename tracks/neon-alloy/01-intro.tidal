-- 1. Intro — beat + bass + filtered synths
-- Eval 00-setup.tidal first.

setbpm 118

d1 $ kick

d3 $ hats # gain 0.7

d8 $ bassMain # lpf 320

xfadeIn 4 8 $ chords # lpf 700 # gain 0.68

-- bring in snare/clap
-- d2 $ snare # gain 0.78

