-- 4. Break — tension, strip back

-- keep the harmony present, just darker; mute instead if it feels too lush
-- xfadeIn 4 8 $ silence
xfadeIn 4 8 $ chords # lpf (range 850 1400 $ slow 8 sine) # gain 0.78

-- thin the drums
xfadeIn 1 4 $ silence

d2 silence

-- the hook carries over from the chorus; fade it if the break should be bare
-- xfadeIn 5 8 $ silence

xfadeIn 3 8 $ hats # gain 0.62

d6 $ hoover # gain 0.78 # lpf 2400

d8 $ stack [bassMain # gain 0.9, bassOct # gain 0.64] # lpf (range 350 520 $ slow 8 sine)

-- meditative at this point, and complex enough

-- fx / build
-- d7 $ riser
-- d3 $ stack [hats # gain 0.7, s "~ ~ 808oh ~" # gain 0.78]

-- drop riser before chorus
-- d7 $ silence
-- d7 $ impact
