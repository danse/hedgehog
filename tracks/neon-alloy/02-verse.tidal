-- 2. Verse — groove settles, hook teases

d1 $ kick

d2 $ snare

d3 $ stack [hats, hatsOpen]

d8 $ stack [bassMain, bassOct # gain 0.74]

d6 $ degradeBy 0.2 $ shimmer

d4 $ chordsStab -- noticeable

