-- Cantilever — acoustic illusion / jazz-adjacent
-- A small imaginary ensemble anchored at one end, extending under load.
-- 92 BPM base · D dorian. Lazy swing, implied polymeter and through-composition,
-- with slight tempo shifts at the structural joints.
--
-- Only Dirt-Samples acoustic banks: double bass, brushed kit, ride, plucked
-- piano, sax, trumpet sparkles, woodblock, metal, breath and wind. No custom
-- samples, no pads/arps/casio timbres, no obvious electronic processing.
--
-- Eval the setup block below, then play the sections in order:
-- Footing → Span → Load → Overhang → Creak → Snap → Settle → Afterimage.
--
-- Gotchas: reverb size <= 0.9; `gain` is amp * gain^4 (trim with gain).

-- ---------------------------------------------------------------------------
-- Voices / patterns. One `let` block: eval all at once (C-RET).
-- Harmony: D dorian, voiced with Sound.Tidal.Chords.
-- ---------------------------------------------------------------------------
let
  -- Shared helpers (speedAt, swing8, swing16, chordAt, fadeSilence, fadeMulti)
  -- live in boot/BootTidal.hs. Only track-specific voices belong here.
  -- Levels: gain is non-linear (amp * gain^4); reverb size <= 0.9. The trumpet
  -- is deliberately quiet and distant — a sparkle, never a feature.
  -- --- harmony: D dorian, through-composed --------------------------------
  -- Harmony is built with Sound.Tidal.Chords (chordAt), not hand-written
  -- voicings. Roots are in the low piano register; the high voice adds an octave.
  hSpan = chordAt "<d4 g4 d4 a4>" "<min9 7sus4 min9 min7>"
  hLoad = chordAt "<d4 f4 g4 a4 d4 b3 c4 d4>" "<min9 maj9 7sus4 min9 min11 maj9 maj9 min9>"
  hOver = chordAt "<d4 f4 g4 a4 b3 c4 d4 g4>" "<min9 maj9 dom7 min9 maj9 maj9 min11 7sus4>"
  hCreak = chordAt "<d4 b3 f4 d4>" "<min9 maj9 maj9 min9>"
  hSnap = chordAt "<d4 g4 d4>" "<min7 dom7 min7>"
  hSettle = chordAt "<d4 g4 c4 f4 d4>" "<min9 dom7 maj9 maj9 min9>"
  hAfter = chordAt "<d4 e4 f4 g4 d4>" "<min9 min7 maj9 7sus4 min9>"
  -- --- piano: pluck samples tuned to their natural pitches ----------------
  -- pluck:5 is C3, pluck:8 is D4 (scientific pitch; Tidal c4/d5). Written
  -- pitches are Tidal letter names, one octave above scientific pitch. Each
  -- voice plays its sample once; `sustain` decides how long it rings.
  pianoLo p = s "pluck" # n 5 # speedAt "c4" p
    # gain 0.68 # sustain 1.2 # release 0.3 # lpf 3000 # lpq 0.3
    # room 0.52 # size 0.68
  pianoHi p = s "pluck" # n 8 # speedAt "d5" p
    # gain 0.6 # sustain 1 # release 0.25 # lpf 4200
    # room 0.58 # size 0.75
  pianoComp p = s "pluck" # n 5 # speedAt "c4" p
    # gain 0.72 # sustain 0.5 # release 0.18 # lpf 3400 # lpq 0.3
    # room 0.32 # size 0.45
  pianoCompHi p = s "pluck" # n 8 # speedAt "d5" p
    # gain 0.56 # sustain 0.4 # release 0.15 # lpf 4800
    # room 0.4 # size 0.55
  pianoPedal = s "pluck" # n 5 # speedAt "c4" (chordAt "d4" "5")
    # gain 0.58 # sustain 1.4 # release 0.7 # lpf 1700 # lpq 0.25
    # room 0.62 # size 0.78
  pianoCreak = pianoLo (slow 4 hCreak)
    # gain 0.56 # sustain 1.8 # release 1 # lpf 1500
    # room 0.68 # size 0.8
  pianoAfter = pianoHi ((slow 4 hAfter) |+ 12)
    # gain 0.52 # sustain 1.8 # release 1 # lpf 1900
    # room 0.72 # size 0.82
  -- --- comping: chords on a rhythm, then swung -----------------------------
  -- swing8 = swingBy (1/5) 4, swing16 = swingBy (1/5) 8. The delay is in the
  -- second half of each slice, so the offbeats lean back.
  compSpan = swing8 (struct "t ~ ~ t ~ ~ t ~" (pianoComp (slow 3 hSpan)))
  compLoad = swing8 (struct "t ~ ~ t ~ ~ t ~" (pianoComp (slow 3 hLoad)))
  compOver = swing8 (struct "t t ~ ~ t ~ ~ t" (pianoComp (slow 3 hOver)))
  compSnap = swing16 (struct "t t ~ t ~ t ~ ~" (pianoComp hSnap))
  compSettle = swing8 (struct "t ~ t ~ ~ t ~ ~" (pianoComp (slow 3 hSettle)))
  colourSpan = swing16 (struct "~ ~ t ~ ~ ~ ~ t" (pianoCompHi ((slow 3 hSpan) |+ 12))) # gain 0.5
  colourLoad = swing16 (struct "~ ~ t ~ ~ t ~ ~" (pianoCompHi ((slow 3 hLoad) |+ 12))) # gain 0.48
  colourOver = swing16 (struct "~ t ~ ~ t ~ ~ t" (pianoCompHi ((slow 3 hOver) |+ 12))) # gain 0.46
  -- --- double bass: bass1:0 is C2 (Tidal c3) ------------------------------
  bassFoot = swing8 $ s "bass1" # n 2 # speedAt "c3" "d3 ~ ~ ~ a2 ~ ~ ~"
    # sustain 1.6 # release 0.55 # gain 0.9 # lpf 620 # lpq 0.2
    # room 0.3 # size 0.48
  bassWalk = swing8 $ s "bass1" # n "<2 2 12 10>" # speedAt "c3" "d3 ~ f3 a3 ~ c4 ~ a2"
    # sustain 0.62 # release 0.22 # gain 0.9 # lpf 820 # lpq 0.25
    # room 0.24 # size 0.42
  bassWalk4 = slow 4 $ s "bass1" # n "<2 12 2 10>" # speedAt "c3" "d3 ~ f3 ~ a2 ~ c3 ~ d3 ~ f3 ~ a2 c3 ~ ~"
    # sustain 0.9 # release 0.3 # gain 0.9 # lpf 760 # lpq 0.22
    # room 0.26 # size 0.44
  bassLoad = swing8 $ s "bass1" # n "<2 12 2 10>" # speedAt "c3" "d3 ~ f3 a3 ~ c4 d4 ~"
    # sustain 0.5 # release 0.2 # gain 0.9 # lpf 900 # lpq 0.26
    # room 0.22 # size 0.4
  bassCreak = slow 2 $ s "bass1" # n 14 # speedAt "c3" "d3 ~ ~ ~ ~ ~ ~ ~"
    # sustain 2.6 # release 1.1 # gain 0.84 # lpf 420 # lpq 0.16
    # room 0.55 # size 0.7
  bassSnap = swing16 $ s "bass1" # n 10 # speedAt "c3" "d3 d3 ~ f3 ~ a2 ~ c3"
    # sustain 0.24 # release 0.1 # gain 0.92 # lpf 1100 # lpq 0.3
    # room 0.18 # size 0.32
  bassSettle = swing8 $ s "bass1" # n "<2 12 2 12>" # speedAt "c3" "d3 ~ f3 ~ a2 ~ c3 ~"
    # sustain 0.8 # release 0.3 # gain 0.9 # lpf 720 # lpq 0.2
    # room 0.3 # size 0.46
  bassAfter = slow 2 $ s "bass1" # n 2 # speedAt "c3" "d3 ~ ~ ~ a2 ~ ~ ~"
    # sustain 1.8 # release 0.9 # lpf 540
    # room 0.52 # size 0.7
  -- --- kick, brushes, ride: gretsch acoustic kit --------------------------
  kickSoft = s "~ gretsch ~ gretsch" # n 13 # gain 0.8 # sustain 0.5 # release 0.15
    # lpf 360 # room 0.16 # size 0.28
  kickSparse = slow 2 $ s "gretsch" # n 13 # gain 0.82 # sustain 0.5 # release 0.18
    # lpf 320 # room 0.18 # size 0.3
  brushFoot = s "~ ~ gretsch ~" # n 3 # sustain 0.3 # release 0.15
    # lpf 2600 # room 0.35 # size 0.5 # amp 4
  brush = swing8 $ s "~ gretsch ~ gretsch" # n "<3 2>" # gain 0.68 # sustain 0.3 # release 0.16
    # lpf 3000 # room 0.28 # size 0.42
  brushGhost = s "~ ~ gretsch ~" # n 3 # gain 0.5 # sustain 0.25 # release 0.12
    # lpf 2800 # room 0.3 # size 0.45
  brushSnap = s "gretsch ~ gretsch ~" # n 23 # gain 0.8 # sustain 0.28 # release 0.12
    # lpf 4200 # room 0.2 # size 0.34
  snareSnap = s "~ gretsch ~ gretsch" # n 22 # gain 0.86 # sustain 0.3 # release 0.14
    # lpf 4800 # room 0.22 # size 0.35
  ride = swing8 $ s "gretsch:19 ~ gretsch:19 gretsch:19 ~ gretsch:19 ~ gretsch:19"
    # gain 0.62 # sustain 0.35 # release 0.15 # lpf 5600 # room 0.24 # size 0.38
  rideBell = swing8 $ s "~ ~ ~ gretsch:18 ~ ~ ~ ~" # gain 0.5 # sustain 0.3 # release 0.2
    # lpf 6400 # room 0.3 # size 0.48
  hat = swing8 $ s "gretsch:4*2" # gain 0.5 # sustain 0.15 # release 0.05
    # lpf 7000 # room 0.1 # size 0.2
  -- --- hand percussion, creaks, air ---------------------------------------
  wood = swing8 $ s "~ ~ east ~ ~ ~ east ~" # n 0 # gain 0.5 # room 0.3 # size 0.38
  -- wood3 is fast-3 against the 4/4 pulse and shime is fast-5; several harmonic
  -- phrases use slow 3/4 against the bass, so the layers drift in and out.
  wood3 = degradeBy 0.25 $ fast 3 (s "east" # n 0 # gain 0.4 # room 0.35 # size 0.42) # amp 4
  shime = degradeBy 0.4 $ fast 5 (s "east" # n 5 # gain 0.34 # room 0.4 # size 0.48)
  rub = slow 2 $ s "gretsch" # n 8 # gain 0.42 # sustain 2.4 # release 1.1
    # hpf 220 # lpf 2200 # room 0.62 # size 0.78
  creak = degradeBy 0.45 $ slow 2 $ s "metal" # n (irand 10) # sustain 0.5
    # speed (range 0.35 0.85 $ slow 4 rand) # gain 0.38 # pan rand
    # hpf 240 # lpf 1900 # room 0.6 # size 0.8
  metalSpark = degradeBy 0.55 $ slow 4 $ s "metal" # n (irand 10) # sustain 1
    # speed (range 0.6 1.2 $ slow 8 rand) # gain 0.34 # pan rand
    # hpf 300 # lpf 3600 # room 0.55 # size 0.72
  air = s "breath" # n 0 # sustain 0.5 # hpf 500 # lpf 2400
    # room 0.65 # size 0.82
  windBed = slow 4 $ s "wind" # n (irand 10) # sustain 8
    # gain 0.12 # hpf 400 # lpf 1500 # room 0.7 # size 0.85
  -- --- sax: sax:5 is C3 (Tidal c4) ----------------------------------------
  reedCall = s "sax" # n 5 # speedAt "c4" "d4 ~ ~ ~ ~ ~ a4 ~ ~ ~ c5 ~ ~ ~ ~ ~"
    # release 0.7 # gain 0.42 # hpf 150 # lpf 1500 # lpq 0.25
    # room 0.62 # size 0.8
  reedLong = slow 4 $ s "sax" # n 5 # speedAt "c4" "d4 ~ ~ ~ a4 ~ ~ ~"
    # sustain 2.4 # release 1.1 # gain 0.4 # hpf 140 # lpf 1200 # lpq 0.2
    # room 0.68 # size 0.82
  reedCreak = slow 8 $ s "sax" # n 5 # speedAt "c4" "d4 ~ ~ ~ ~ ~ ~ ~"
    # sustain 4 # release 2 # gain 0.36 # hpf 120 # lpf 900 # lpq 0.18
    # room 0.75 # size 0.85
  -- --- trumpet: high, distant, never featured -----------------------------
  -- trump:5 is B5 (Tidal b6); trump:7 is E6 (Tidal e7). slow 16 means each
  -- written note lands once every 16 cycles; expect long silences between stabs.
  trumpetOver = slow 16 $ s "trump" # n 5 # speedAt "b6" "d6 ~ ~ ~ ~ ~ ~ ~ ~ f6 ~ ~ ~ ~ ~ ~" # sustain 0.5
    # gain 0.34 # release 0.3 # lpf 2200 # lpq 0.2 # room 0.72 # size 0.82
  trumpetSnap = slow 16 $ s "trump" # n 7 # speedAt "e7" "~ ~ ~ ~ ~ ~ a6 ~ ~ ~ ~ ~ ~ ~ ~ ~" # sustain 0.5
    # gain 0.36 # release 0.3 # lpf 3000 # room 0.6 # size 0.75
  trumpetAfter = slow 16 $ s "trump" # n 5 # speedAt "b6" "~ ~ ~ ~ d6 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~" # sustain 0.5
    # gain 0.24 # release 0.4 # hpf 300 # lpf 1200 # lpq 0.25 # room 0.8 # size 0.85
  -- --- a small melodic answer for Settle --------------------------------
  pianoMotif = slow 2 $ s "pluck" # n 8 # speedAt "d5" "a5 ~ c6 ~ d6 ~ a5 ~ f5 ~ e5 ~ d5 ~ ~ ~"
    # gain 0.52 # sustain 0.5 # release 0.25 # lpf 3600
    # room 0.45 # size 0.6
  motifSettle = swing16 (degradeBy 0.15 pianoMotif)

-- 1. Footing — the anchor is set. Solo double bass, room, a foot tap.
-- ~32 cycles (~84 s at 92 BPM).

-- setbpm jumps the clock; glideBpm steps the tempo 10x/s over 16 s, starting
-- from the tempo current at call time. Leave each section long enough to finish.
glideBpm 92 16

d1 bassFoot

-- brushes arrive like a foot keeping time, not a drum kit
d2 brushFoot
-- a low piano pedal appears under the bass
d3 pianoPedal
-- first hint of the room: a single breath
d4 $ slow 2 air

-- breathe

-- the bass starts to walk, providing time before `span`
d1 bassWalk

-- 2. Span — the beam extends. Ride, comping, and a 3-against-4 woodblock.
-- ~40 cycles (~104 s at 92 BPM).

glideBpm 92 16
xfadeIn 2 12 brush
xfadeIn 5 24 ride
xfadeIn 3 24 compSpan
xfadeIn 6 32 colourSpan

-- implied polymeter: three woodblock hits per cycle against the 4/4 pulse
d7 wood3

-- the bass phrase stretches over four cycles
d1 bassWalk4

-- 3. Load — the span takes weight. The full ensemble, still lazy.
-- ~40 cycles (~104 s at 92 BPM).

d8 kickSoft
xfadeIn 3 16 compLoad
xfadeIn 6 24 colourLoad

-- the reed joins from the back of the room
d9 $ degrade $ reedCall # gain 0.7

-- add a little ride bell for lift
d5 $ stack [ride, rideBell]

-- 4. Overhang — the far end hangs. Tempo nudges up; the structure sings.
-- ~40 cycles (~98 s at 98 BPM).

-- you get here with a very present reedCall on a main downbeat
-- xfadeIn 9 16 silence
-- if it's silenced we can listen to the rest of the texture for a bit

glideBpm 98 16
d8 kickSoft
d2 brush
d5 $ stack [ride, rideBell]
d1 bassLoad
xfadeIn 3 16 compOver
xfadeIn 6 24 colourOver

-- two distant trumpet stabs, never a solo
d10 trumpetOver

-- breathe. This rings enough to keep adding phrases over time, but
-- it's a very gentle development

-- tiny 5-against-4 shime shimmer
d7 shime
-- let the piano high voice ring
d6 $ pianoHi $ slow 3 hOver |+ 12

-- gives another break to prepare `creak`

-- 5. Creak — the structure complains. Tempo drops; the room takes over.
-- ~32 cycles (~89 s at 86 BPM).

glideBpm 86 16
-- the kit and the trumpet fall away; a cymbal rub remains
fadeSilence 8 [2,8,10]
xfadeIn 7 12 creak
xfadeIn 5 16 rub
xfadeIn 4 32 air

-- breathe

-- bass becomes a long pedal, piano turns to low clusters
fadeMulti 32 [
  (1, bassCreak),
  (3, pianoCreak),
  (6, pianoHi (slow 4 hCreak |+ 12) # gain 0.42 # lpf 1400)]

-- the reed stretches out
d9 reedCreak

-- optional: a single metal creak answers the piano
xfadeIn 7 24 $ degradeBy 0.7 metalSpark

-- 6. Snap — the beam breaks. A short, hard release, then the hole.
-- ~24 cycles (~60 s at 96 BPM).

-- creak is interesting at this point

-- this adds rhythm
glideBpm 96 16
fadeMulti 16 [
  (8, kickSoft),
  (2, brushSnap),
  (5, ride),
  (1, bassSnap),
  (3, compSnap),
  (7, stack [metalSpark, wood])]

-- breathe

-- Step 2 (after ~8 cycles): the hole — everything but the trumpet drops out
fadeSilence 16 [1,2,3,5,6,7,8,9]
xfadeIn 10 16 trumpetSnap
-- together it's a sharp transition
-- Step 3 (after the stab): bass alone, then Settle
xfadeIn 1 16 bassSettle

-- 7. Settle — the structure comes to rest. Tempo back to 92.
-- ~40 cycles (~104 s at 92 BPM).

glideBpm 92 16
fadeSilence 8 [7,10]
d8 kickSoft
d2 brush
d5 ride
d1 bassSettle
xfadeIn 3 16 compSettle

-- a bluesy piano answer, sparse
d6 motifSettle
-- the reed returns for one phrase
d9 reedCall

-- no trumpet here; let the room do the sparkle

-- 8. Afterimage — open coda. The room keeps the shape after the sound.
-- ~40+ cycles at 92 BPM; open-ended.

glideBpm 92 16
-- strip the rhythm and most of the harmony
fadeSilence 16 [1,2,3,5,6,7,8,9,10]
-- leave a high piano shadow, filtered trumpet, metal and air
xfadeIn 6 24 pianoAfter
xfadeIn 10 32 trumpetAfter
xfadeIn 7 24 metalSpark
xfadeIn 4 32 (stack [air, windBed])

-- the bass returns once, very low
xfadeIn 1 24 $ bassAfter # gain 0.82
-- the last chord: let it ring
xfadeIn 3 32 $ pianoLo (slow 8 hAfter) # lpf 1200 # room 0.8 # size 0.85

-- breathe

-- final fade: everything still sounding (piano, bass, trumpet, metal, air)
fadeSilence 24 [1,3,4,6,7,10]

-- hush when the room has decayed
hush
