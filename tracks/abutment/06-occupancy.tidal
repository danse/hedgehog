-- 6. Occupancy — the span is rebuilt; people return; the abutment disappears
-- under the approach. ~40 cycles (~107 s at 90 BPM).

glideBpm 90 16
d1 kickSoft
d2 brush
d3 (stack [ride, rideBell])
d6 bassOcc
xfadeIn 4 16 compOcc
xfadeIn 5 24 colourOcc

-- the warm melody
d7 reedOcc
fadeMulti 24 [
  (8, trumpetOcc),
  (9, degradeBy 0.5 wood),
  (10, stack [air, gravel]),
  (7, silence)]
