-- 2. Gate — The barrier, the turnstile, the dropped ticket, a pigeon.
-- The first shift arrives; four gate hits carry the work song's rhythm.
-- ~40 cycles (~100 s at 96 BPM).

glideBpm 96 16
-- the gate takes over the pulse
d2 $ stack [gateTick, degradeBy 0.25 gateClang]
fadeMulti 16 [(1, bootWork), (4, compGate)]

d6 $ bassGate # amp 0.4

fadeMulti 24 [
  -- the high colour of the fence
  (5, colourGate),
  -- the pigeon and the dropped ticket, off to one side
  (9, stack [pigeon, ticket])]

-- brushes and ride arrive with the first shift
fadeMulti 24 [(1, stack [bootWork, brushSoft]), (3, rideSoft)]
