-- Neon Alloy — glam electro-pop / synth noir
-- 118 BPM · A minor. Driving bass, crisp electro drums, shimmering synths and
-- hooks. Uses hedge_sine/hedge_pad/hedge_noise.
--
-- Eval the setup block below, then play the sections in order:
-- Intro → Verse → Chorus → Break → Final.
--
-- Gotchas: reverb size <= 0.9; `gain` is amp = amp * gain^4.

glideBpm 118 16

-- ---------------------------------------------------------------------------
-- Voices / patterns (eval this whole block together)
-- ---------------------------------------------------------------------------
let
  -- kick
  kick = s "808bd(<3 4>,8)" # n 0 # gain 0.9 # lpf 220 # room 0.04 # size 0.12
  kickDrive = s "808bd*4" # n "<0 0 1 0>" # gain 0.88 # lpf 240 # room 0.03 # size 0.1
  --
  -- snare / clap
  snare = s "~ 808sd ~ 808sd" # n 1 # gain 0.84 # lpf 4200 # room 0.12 # size 0.2
  clap = s "~ cp ~ [~ cp?]" # gain 0.8 # room 0.18 # size 0.3 # lpf 5000
  --
  -- hats / percussion
  hats = s "[808hc*2 808oh] 808hc*2 [808hc 808oh?] 808hc*2" # gain (range 0.68 0.8 $ slow 4 rand)
    # pan (range 0.4 0.6 $ fast 2 rand) # lpf 9000 # room 0.06 # size 0.1
  hatsOpen = s "~ ~ 808oh ~" # gain 0.76 # release 0.12 # room 0.08 # size 0.12
  perc = degradeBy 0.25 $ s "glitch(3,8,<0 5>)" # n (irand 8) # gain 0.72 # speed (choose [1,1.5,2]) # lpf 5000 # room 0.1 # size 0.15
  --
  -- bass (driving, glam-electro; complex enough to move, not sparse)
  bassGain = gain 1
  bassRiff = "<[a1 a1 ~ a2 ~ g2 ~ e2] [f1 ~ f1 a1 ~ c2 ~ a1] [g1 g1 ~ g2 ~ e2 ~ d2] [e1 ~ e1 g1 ~ b1 ~ gs1]>"
  bassMain = note bassRiff # s "hedge_sine"
    # sustain "0.22 0.18 0.12 0.28 0.1 0.2 0.12 0.24"
    # lpf (range 220 900 $ slow 8 sine) # lpq 0.18 # shape 0.15
    # room 0.06 # size 0.12
  bassOct = note (bassRiff |- 12) # s "hedge_sine"
    # sustain 0.16 # lpf 1400 # lpq 0.12 # shape 0.2
  bassDrive = fast 2 $ note "<a1 f1 g1 e1>" # s "hedge_sine"
    # sustain 0.14 # lpf (range 300 1200 $ fast 2 saw) # lpq 0.22 # shape 0.25
  chordsGain = amp 2
  --
  -- chords / synth bed (supporting, kept under bass/drums/hook)
  chords = slow 2 $ n "<[a3,c4,e4] [f3,a3,c4] [g3,b3,d4] [e3,gs3,b3]>" # s "hedge_pad"
    # sustain 1.3 # chordsGain # lpf (range 700 1800 $ slow 8 sine) # room 0.32 # size 0.5
  chordsStab = degradeBy 0.15 $ n "<[a4,c5,e5] ~ [f4,a4,c5] ~ [g4,b4,d5] ~ [e4,gs4,b4] ~>" # s "moog"
    # legato 0.3 # lpf 1700 # room 0.22 # size 0.3 # amp 0.1
  arp = fast 2 $ n "a4 c5 e5 a5 e5 c5" # s "arpy"
    # chordsGain # legato 0.45 # speed (choose [1,1,1,2]) # lpf (range 1400 3200 $ slow 4 sine) # room 0.25 # size 0.35 # amp 0.3
  --
  -- lead / hook
  hook = slow 2 $ n "<a5 ~ c6 b5 ~ a5 g5 ~ e5 ~ g5 a5 ~ ~ ~ ~>" # s "arpy"
    # gain 0.84 # legato 0.55 # delay 0.4 # delaytime (3/16) # delayfb 0.3
    # lpf 4200 # room 0.45 # size 0.55
  lead = n "<~ a4 ~ c5 ~ e5 ~ [d5 c5]>" # s "casio"
    # gain 0.8 # legato 0.4 # speed 1 # lpf 3500 # room 0.35 # size 0.45
  --
  -- texture / accents
  stab = s "stab(3,8)" # n (irand 8) # gain 0.78 # lpf 3000 # room 0.2 # size 0.3
  -- `hoover` depends on your Dirt-Samples; swap if missing (`moog`, `stab`,
  -- `arpy` are safe fallbacks).
  hoover = slow 4 $ n "<a3 f3 g3 e3>" # s "hoover" # gain 0.76 # legato 0.8 # lpf 2000 # room 0.4 # size 0.5
  shimmer = degradeBy 0.3 $ fast 2 $ s "space:2*4?" # speed (range 1 2.5 $ rand) # gain 0.68 # hpf 1200 # lpf 7000 # room 0.35 # size 0.45
  --
  -- fx
  riser = s "hedge_noise" # sustain 4 # gain (range 0.42 0.8 $ slow 4 saw) # lpf (range 400 6000 $ slow 4 saw) # room 0.75 # size 0.7
  impact = s "industrial:1" # gain 0.82 # speed 0.7 # lpf 1800 # room 0.3 # size 0.4

-- 1. Intro — beat + bass + filtered synths

d1 kick
xfadeIn 2 24 hats

d3 $ bassMain # lpf 320

d4 snare
d3 $ stack [bassMain, bassOct]

xfadeIn 5 8 $ chords # lpf 400

-- 2. Verse — groove settles, hook teases

d2 $ stack [hats, hatsOpen]
d6 $ degradeBy 0.2 $ shimmer
-- tease the hook
d7 $ hook # lpf 2800

-- breathe

d6 $ stack [shimmer, stab]

xfadeIn 5 8 chordsStab -- noticeable

-- 3. Chorus — full lift

d4 $ stack [snare, clap]
d2 $ stack [hats, hatsOpen, perc # gain 0.66]
d7 hook
d6 $ stack [stab, shimmer # gain 0.64]
xfadeIn 5 8 silence

xfadeIn 5 32 $ stack [chords, arp] -- juggler melody

-- drive variation
d1 kickDrive
d3 bassDrive
xfadeIn 5 16 $ stack [chords, arp, chordsStab] -- future melody

-- pull back
d7 lead
d1 kick
d3 $ stack [bassMain, bassOct]
xfadeIn 5 8 $ chords # lpf (range 850 1400 $ slow 8 sine)

-- 4. Break — tension, strip back

fadeMulti 16 [
  (1, silence),
  (4, silence),
  (2, hats),
  (5, silence)]

d6 hoover
d3 $ stack [bassMain, bassOct]

-- meditative at this point, and complex enough, but there is some
-- noise on the bass

-- fx / build
d8 riser
d2 $ stack [hats, s "~ ~ 808oh ~" # gain 0.78]

-- drop riser before chorus
d8 impact

-- 5. Final — last chorus and outro

-- wake up again
fadeMulti 16 [
  (1, kick),
  (4, stack [snare, clap # gain 0.74]),
  (2, stack [hats, hatsOpen]),
  (7, hook),
  (6, stab)]

-- outro: fade elements

-- supporting
fadeMulti 8 [
  (5, stack [chords, arp]),
  (7, silence),
  (6, silence)]

xfadeIn 5 16 $ chords # lpf (range 900 1400 $ slow 8 sine) # gain 0.78

fadeSilence 16 [1,2,4]
xfadeIn 3 16 $ stack [bassMain # gain 0.94, bassOct # gain 0.6] # lpf 400

fadeSilence 16 [3,5]

hush
