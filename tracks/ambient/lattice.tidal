-- Lattice — ambient / a playable grid
-- 96 BPM · D minor. Four-bar loop: Dm9 | Bbmaj9 | Fmaj9 | C6/9. Written here,
-- no outside source. Ten seats and eight named movements. Each row is a
-- `mkMovement` cell map: Score cells are the default band, Optional cells are
-- voices on the table, and entering a row mutes what it does not score. The
-- matrix chooses what; the live call chooses how.
--
-- Eval the setup block first. `mPlay opening >>= multi clutchIn 16` enters a
-- row and lists its optionals. `mOptionals opening` shows what is waiting.
-- `koto opening` is a pattern you put under `p`, `clutchIn`, `xfadeIn`,
-- `attacks` or `multi`.
-- Double blank = landing. ~7:30 at 96 BPM if each row is held for four cycles.
--
-- dN is a seat: 1 sub, 2 pad, 3 clock, 4 koto, 5 bells, 6 reed, 7 air, 8 dust,
-- 9 fig, 10 shadow — a high figuration pair, optional in every row.
-- Rows have short names in the setup; the `Movements` bundle is for tooling,
-- the local rows are what you call. No fixed order: visit rows by ear.
--
-- Gotchas: shared rules in notes/learning/gotchas.md.
-- track-levels.py cannot see matrix cells yet; mix this one by ear.
-- Sample bases: moog:1 C3 and juno:8 C5, so speedAt tunes from those.
-- hedge_clock, hedge_koto, supervibe, hedge_melodica and supernoise keep their
-- own pitch bases. fig/shadow borrow filigree's pluck/casio pair at four times
-- the cell rate, dry-fronted so they read over the pad. Keep size <= 0.9 and
-- trim with amp, not gain.

glideBpm 96 30

-- ---------------------------------------------------------------------------
-- Reused voices, patterns and movement rows. Keep this whole block one
-- paragraph: C-RET evaluates it together.
-- ---------------------------------------------------------------------------
let
  -- Seat names, shared by every row so mShow/mOptionals can talk in voices.
  labels = [(1, "sub"), (2, "pad"), (3, "clock"), (4, "koto"),
            (5, "bells"), (6, "reed"), (7, "air"), (8, "dust"),
            (9, "fig"), (10, "shadow")]
  --
  loopRoot :: Pattern Note
  loopRoot = "<d3 bf2 f2 c3>"
  --
  loopQual :: Pattern String
  loopQual = "<min9 maj9 maj9 sixNine>"
  --
  loop :: Pattern Note
  loop = chordAt loopRoot loopQual
  --
  subRoot :: Pattern Note
  subRoot = "<d2 bf1 f2 c2>"
  --
  airRoot :: Pattern Note
  airRoot = "<d3 bf2 f2 c3>"
  --
  -- Voices. Everything is a ControlPattern; the matrix stores finished sounds.
  subVoice p = slow 2 $ speedAt "c3" p # s "moog:1"
    # sustain 2 # lpf 380 # room 0.18 # size 0.3 # amp 0.32
  --
  padVoice p = slow 4 $ speedAt "c5" p # s "juno:8"
    # sustain 3 # lpf 1800 # room 0.62 # size 0.74 # amp 0.2
  --
  clockVoice p = swing8 $ note p # s "hedge_clock"
    # pF "metal" 0.62 # decay 0.07 # sustain 0.08
    # pan 0.58 # room 0.08 # size 0.2 # amp 0.5
  --
  kotoVoice p = swing8 $ note p # s "hedge_koto"
    # pF "damp" 0.3 # pF "bend" 0.55 # decay 2.4 # sustain 2
    # pan (-0.42) # room 0.58 # size 0.72 # amp 0.34
  --
  bellVoice p = slow 2 $ note p # s "supervibe"
    # pF "modamp" 1.2 # decay 0.9 # sustain 1.5
    # room 0.82 # size 0.86 # amp 0.3
  --
  reedVoice p = swing8 $ note p # s "hedge_melodica"
    # pF "reed" 0.62 # pF "bright" 1600 # decay 0.2 # sustain 1.2
    # pan 0.3 # room 0.72 # size 0.78 # amp 0.3
  --
  airVoice p = slow 4 $ note p # s "supernoise"
    # resonance 0.3 # voice 0.45 # pitch1 0.7 # rate 0.5
    # sustain 5 # lpf 720 # hpf 120 # room 0.86 # size 0.88 # amp 0.12
  --
  dustVoice p = slow 2 $ note p # s "supernoise"
    # resonance 0.46 # voice 0.3 # pitch1 1.2 # rate 0.8
    # sustain 2 # hpf 2200 # lpf 5200 # pan rand
    # room 0.86 # size 0.88 # amp 0.07
  --
  -- Figuration pair, after filigree: one three-note turn at four times the
  -- rate, rotated once per cycle; shadow runs the reversed turn against it.
  -- Both are mixed dry and forward so they read over the pad; fig sits ahead
  -- of shadow.
  figCell :: Pattern Note
  figCell = "d5 f5 a5"
  --
  figPat = iter 3 $ fast 4 figCell
  shadowPat = iter 3 $ fast 4 (rev figCell)
  --
  figVoice p = note p # s "pluck" # sustain 0.26 # release 0.18
    # hpf 700 # lpf 6400 # delay 0.18 # delaytime (3/16) # delayfb 0.18
    # pan (-0.2) # room 0.24 # size 0.36 # amp 0.46
  --
  shadowVoice p = note p # s "casio" # legato 0.6
    # hpf 600 # lpf (range 2800 6200 $ slow 12 sine)
    # delay 0.16 # delaytime (1/4) # delayfb 0.16
    # pan 0.24 # room 0.3 # size 0.42 # amp 0.34
  --
  -- Variants. The second score of each pair is the widened one, used where
  -- the grid opens. Only the cells change; the voice builders do not.
  kotoPlain = cat [
      "d5 ~ a4 ~ ~ ~ a4 ~ d5 ~ f4 ~ ~ ~ f4 ~",
      "f4 ~ d4 ~ ~ ~ d4 ~ f4 ~ a4 ~ ~ ~ a4 ~",
      "a4 ~ c5 ~ ~ ~ c5 ~ a4 ~ g4 ~ ~ ~ g4 ~",
      "g4 ~ a4 ~ ~ ~ a4 ~ g4 ~ e4 ~ ~ ~ e4 ~"]
  --
  kotoHigh = cat [
      "d5 ~ f5 ~ ~ ~ f5 ~ d5 ~ a4 ~ ~ ~ a4 ~",
      "f4 ~ a4 ~ ~ ~ a4 ~ f4 ~ d5 ~ ~ ~ d5 ~",
      "a4 ~ c5 ~ ~ ~ c5 ~ a4 ~ e5 ~ ~ ~ e5 ~",
      "g4 ~ c5 ~ ~ ~ c5 ~ g4 ~ a4 ~ ~ ~ a4 ~"]
  --
  bellPlain = cat [
      "~ ~ a5 ~ ~ ~ ~ ~ c6 ~ ~ ~ a5 ~ ~ ~",
      "~ ~ f5 ~ ~ ~ ~ ~ a5 ~ ~ ~ f5 ~ ~ ~",
      "~ ~ g5 ~ ~ ~ ~ ~ c6 ~ ~ ~ g5 ~ ~ ~",
      "~ ~ e5 ~ ~ ~ ~ ~ a5 ~ ~ ~ e5 ~ ~ ~"]
  --
  bellWide = cat [
      "a5 ~ c6 ~ e6 ~ ~ ~ a5 ~ c6 ~ ~ ~ e6 ~",
      "f5 ~ a5 ~ c6 ~ ~ ~ f5 ~ a5 ~ ~ ~ c6 ~",
      "g5 ~ c6 ~ e6 ~ ~ ~ g5 ~ c6 ~ ~ ~ e6 ~",
      "e5 ~ a5 ~ c6 ~ ~ ~ e5 ~ a5 ~ ~ ~ c6 ~"]
  --
  reedPlain = cat [
      "~ a4 ~ ~ ~ c5 ~ a4 ~ ~ ~ ~ ~ g4 ~ ~",
      "~ f4 ~ ~ ~ a4 ~ f4 ~ ~ ~ ~ ~ d4 ~ ~",
      "~ g4 ~ ~ ~ c5 ~ g4 ~ ~ ~ ~ ~ e4 ~ ~",
      "~ e4 ~ ~ ~ g4 ~ e4 ~ ~ ~ ~ ~ d4 ~ ~"]
  --
  reedAnswer = cat [
      "~ ~ ~ ~ d5 ~ ~ ~ c5 ~ ~ ~ a4 ~ ~ ~",
      "~ ~ ~ ~ c5 ~ ~ ~ a4 ~ ~ ~ f4 ~ ~ ~",
      "~ ~ ~ ~ e5 ~ ~ ~ d5 ~ ~ ~ c5 ~ ~ ~",
      "~ ~ ~ ~ d5 ~ ~ ~ c5 ~ ~ ~ a4 ~ ~ ~"]
  --
  clockPat = cat [
      "d6 ~ ~ ~ a5 ~ ~ ~ d6 ~ ~ ~ f5 ~ ~ ~",
      "bf5 ~ ~ ~ d6 ~ ~ ~ bf5 ~ ~ ~ f5 ~ ~ ~",
      "f5 ~ ~ ~ a5 ~ ~ ~ f5 ~ ~ ~ c6 ~ ~ ~",
      "c6 ~ ~ ~ e6 ~ ~ ~ c6 ~ ~ ~ g5 ~ ~ ~"]
  --
  dustPat = cat [
      "d5 ~ ~ ~ a4 ~ ~ ~",
      "f4 ~ ~ ~ d4 ~ ~ ~",
      "a4 ~ ~ ~ c5 ~ ~ ~",
      "g4 ~ ~ ~ e4 ~ ~ ~"]
  --
  -- Named accessors. Each is a pure pattern lookup; no fade is hidden here.
  sub   = mkVoice 1 "sub"
  pad   = mkVoice 2 "pad"
  clock = mkVoice 3 "clock"
  koto  = mkVoice 4 "koto"
  bells = mkVoice 5 "bells"
  reed  = mkVoice 6 "reed"
  air   = mkVoice 7 "air"
  dust  = mkVoice 8 "dust"
  fig   = mkVoice 9 "fig"
  shadow = mkVoice 10 "shadow"
  --
  -- The rows. mPlay lists optionals and mutes them with the row's transition;
  -- the calls below bring chosen ones back in.
  opening = mkMovement "opening" labels
        [ (1, Score (subVoice subRoot))
        , (2, Score (padVoice loop))
        , (4, Optional (kotoVoice kotoPlain))
        , (7, Optional (airVoice airRoot))
        , (9, Optional (figVoice figPat))
        , (10, Optional (shadowVoice shadowPat))
        ]
  --
  ticks = mkMovement "ticks" labels
        [ (1, Score (subVoice subRoot))
        , (2, Score (padVoice loop))
        , (3, Score (clockVoice clockPat))
        , (4, Score (kotoVoice kotoPlain))
        , (5, Optional (bellVoice bellPlain))
        , (8, Optional (dustVoice dustPat))
        , (9, Optional (figVoice figPat))
        , (10, Optional (shadowVoice shadowPat))
        ]
  --
  chimes = mkMovement "chimes" labels
        [ (1, Score (subVoice subRoot))
        , (2, Score (padVoice loop))
        , (3, Score (clockVoice clockPat))
        , (5, Score (bellVoice bellPlain))
        , (4, Optional (kotoVoice kotoPlain))
        , (9, Optional (figVoice figPat))
        , (10, Optional (shadowVoice shadowPat))
        ]
  --
  reedline = mkMovement "reedline" labels
        [ (1, Score (subVoice subRoot))
        , (2, Score (padVoice loop # lpf 1400))
        , (6, Score (reedVoice reedPlain))
        , (4, Optional (kotoVoice kotoHigh))
        , (7, Optional (airVoice airRoot))
        , (9, Optional (figVoice figPat))
        , (10, Optional (shadowVoice shadowPat))
        ]
  --
  wide = mkMovement "wide" labels
        [ (1, Score (subVoice subRoot))
        , (2, Score (padVoice loop # lpf 2600))
        , (3, Score (clockVoice clockPat))
        , (5, Score (bellVoice bellWide))
        , (4, Optional (kotoVoice kotoHigh))
        , (8, Optional (dustVoice dustPat))
        , (9, Optional (figVoice figPat))
        , (10, Optional (shadowVoice shadowPat))
        ]
  --
  answer = mkMovement "answer" labels
        [ (1, Score (subVoice subRoot))
        , (2, Score (padVoice loop # lpf 1800))
        , (6, Score (reedVoice reedAnswer))
        , (5, Optional (bellVoice bellPlain))
        , (7, Optional (airVoice airRoot))
        , (9, Optional (figVoice figPat))
        , (10, Optional (shadowVoice shadowPat))
        ]
  --
  reweave = mkMovement "reweave" labels
        [ (1, Score (subVoice subRoot))
        , (2, Score (padVoice loop # lpf 3200))
        , (3, Score (clockVoice clockPat))
        , (4, Score (kotoVoice kotoHigh))
        , (5, Optional (bellVoice bellWide))
        , (8, Optional (dustVoice dustPat))
        , (9, Optional (figVoice figPat))
        , (10, Optional (shadowVoice shadowPat))
        ]
  --
  dissolve = mkMovement "dissolve" labels
        [ (1, Score (subVoice subRoot))
        , (2, Score (padVoice loop # lpf 1200))
        , (7, Score (airVoice airRoot))
        , (8, Score (dustVoice dustPat))
        , (4, Optional (kotoVoice kotoPlain))
        , (9, Optional (figVoice figPat))
        , (10, Optional (shadowVoice shadowPat))
        ]
  --
  -- The bundle exists for tooling; the local rows above are the live names.
  grid = mkMovements [opening, ticks, chimes, reedline, wide, answer, reweave, dissolve]


-- opening — sub and pad only. Koto and air are on the table.
mPlay opening >>= multi clutchIn 16


-- ticks — air leaves; clock and koto enter. Bell and dust are optional.
mPlay ticks >>= multi clutchIn 16
clutchIn 5 8 $ bells ticks

-- chimes — dust leaves; bells take the foreground. Koto can stay or go.
mPlay chimes >>= multi clutchIn 16
xfadeIn 4 8 $ koto chimes


-- reedline — clock and bells fade; reed enters. Air and high koto are offered.
mPlay reedline >>= multi clutchIn 16
xfadeIn 7 8 $ air reedline
xfadeIn 4 8 $ koto reedline

-- wide — clock returns and the bells widen. Dust is a straight attack.
mPlay wide >>= multi clutchIn 16
d8 $ dust wide

-- answer — clock and bells leave; the reed answers. Bell and air wait.
mPlay answer >>= multi clutchIn 16
clutchIn 5 8 $ bells answer
xfadeIn 7 8 $ air answer


-- reweave — clock and high koto return. Wide bells and dust are offered.
mPlay reweave >>= multi clutchIn 16
xfadeIn 5 8 $ bells reweave
clutchIn 8 8 $ dust reweave

-- dissolve — mPlay fades clock, bells, reed and koto; air and dust remain.
mPlay dissolve >>= multi xfadeIn 16
xfadeIn 4 8 $ koto dissolve

-- End — let the bed ring, then fade the bed and any live fig/shadow.
fadeSilence 24 [1,2,7,8,9,10]
