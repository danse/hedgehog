  "~ ~ ~ ~ [d5,f4] ~ ~ ~ [as4,d5,gs5] ~ ~ ~ ~ ~ ~ ~ [f5,g4] ~ ~ ~ [d5,f5,g5] ~ ~ ~ ~ ~ ~ ~ [ds5,g4] ~ ~ ~ [c5,ds5,g5] ~ ~ ~ ~ ~ ~ ~ [ds5,fs4] ~ ~ ~ [c5,ds5,fs5] ~ ~ ~",
  "~ ~ ~ ~ [ds5,f4] ~ ~ ~ [as4,ds5,gs5] ~ ~ ~ ~ ~ ~ ~ [d5,f4] ~ ~ ~ [as4,gs5] ~ ~ ~ ~ ~ ~ ~ [ds5,g4] ~ ~ ~ [as4,ds5,g5] ~ ~ ~ ~ ~ ~ ~ [ds5,g4] ~ ~ ~ [as4,ds5,g5] ~ ~ ~"])
d4 $ bassAt (cat [
  "ds3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ds4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ds3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ d3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~",
  "c3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ c4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ f3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ f3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~",
