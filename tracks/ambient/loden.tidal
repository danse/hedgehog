-- Loden — cinematic ambient
-- 88 BPM · F minor / A♭ major. Four-bar loop: Fm9 | D♭maj9 | E♭6/9 | Cm7.
-- No drums. Long-form: clutchIn fades every seat, old out as new comes in.
-- Evaluate sections in order; hush is separate.
-- Gotchas: shared rules in notes/learning/gotchas.md.

glideBpm 88 24

-- Each voice with two scores keeps its variants in one record, so a live call
-- reads `koto utopia` or `melodica plain`: the field is the score selector.
-- For a one-off score, use `koto $ const score`.
data Variants = Variants { plain :: Pattern Note, utopia :: Pattern Note }

let
  bedPlay t = slow 4 $ note t
    # s "superhammond" # pF "vibrato" 0.18
    # room 0.9 # size 0.85 # amp 0.17
  -- string bed; replaces hedge_pad with the Hammond's string ensemble drawbar
  bed = bedPlay (cat [
      "f3,af3,c4,ef4",
      "df3,f3,af3,c4",
      "ef3,g3,bf3,f4",
      "c3,ef3,g3,bf3"])
    # voice 4 # pF "vibrato" 0.18 # pF "vrate" 5
    # sustain 4 # lpf 1300
  --
  -- the ritual holds the opening chord; the bass-violin drawbar keeps it low
  ritualBed = bedPlay "f3,af3,c4,ef4"
    # voice 0 # pF "vibrato" 0.1 # pF "vrate" 3
    # sustain 10 # lpf 900
  --
  -- Morricone saw: long notes with swung pickups into the next phrase
  sawLead = swing8 $ note (cat [
      "c4 ~ ~ ~ ~ ~ g4 ~ af4 ~ ~ ~ g4 ~ ef4 ~",
      "df4 ~ ~ ~ ~ ~ c4 ~ f4 ~ ~ ~ c4 ~ af4 ~",
      "bf3 ~ ~ ~ ~ ~ f4 ~ g4 ~ ~ ~ f4 ~ ef4 ~",
      "ef4 ~ ~ ~ ~ ~ bf3 ~ c4 ~ ~ ~ bf3 ~ g4 ~"])
    # s "supersaw" # voice 0.35 # resonance 0.18 # lfo 1.6
    # pitch1 0.6 # sustain 2.6 # decay 0.12
    # lpf 2800 # room 0.85 # size 0.9 # amp 0.2
  -- the call/response gatings are reused across several sections
  sawAsk = when odd (const silence) sawLead
  sawAnswer = when even (const silence) sawLead
  --
  -- filtered air, one root per bar
  air = note (cat ["f2", "df2", "ef2", "c2"])
    # s "supernoise" # resonance 0.28 # voice 0.45 # pitch1 0.7 # rate 0.5
    # sustain 6 # lpf 620 # hpf 110 # room 0.9 # size 0.9 # amp 0.1
  --
  -- fine airborne grain; texture rather than a voice
  dust = slow 2 $ note (cat [
      "af3 ~ ~ ~ df3 ~ ~ ~",
      "df3 ~ ~ ~ af3 ~ ~ ~",
      "ef3 ~ ~ ~ c3 ~ ~ ~",
      "c3 ~ ~ ~ ef3 ~ ~ ~"])
    # s "supernoise" # resonance 0.45 # voice 0.3 # pitch1 1.2 # rate 0.8
    # sustain 2 # hpf 2200 # lpf 5200 # pan rand # room 0.9 # size 0.9 # amp 0.08
  --
  -- swung tremolo picking; an eight-stroke pulse, orbit 1 keeps the wobble off
  tremolo = swing8 $ note (cat [
      "af4 ~ af4 ~ af4 ~ af4 ~ af4 ~ af4 ~ af4 ~ af4 ~",
      "f4 ~ f4 ~ f4 ~ f4 ~ f4 ~ f4 ~ f4 ~ f4 ~",
      "g4 ~ g4 ~ g4 ~ g4 ~ g4 ~ g4 ~ g4 ~ g4 ~",
      "ef4 ~ ef4 ~ ef4 ~ ef4 ~ ef4 ~ ef4 ~ ef4 ~ ef4 ~"])
    # s "supermandolin" # detune 0.35 # sustain 0.55
    # orbit 1 # tremolorate 5.5 # tremolodepth 0.85
    # pan 0.42 # room 0.8 # size 0.8 # amp 0.32
  --
  -- bass violin, not a synth bass: roots and fifths with a swung offbeat
  lowStrings = swing8 $ note (cat [
      "f2 ~ ~ ~ f2 ~ c3 ~",
      "df2 ~ ~ ~ df2 ~ af2 ~",
      "ef2 ~ ~ ~ ef2 ~ bf2 ~",
      "c2 ~ ~ ~ c2 ~ g2 ~"])
    # s "superhammond" # voice 0 # pF "vibrato" 0.12 # pF "vrate" 4
    # sustain 2.5 # lpf 520 # room 0.55 # size 0.6 # amp 0.2
  --
  -- high glints: three lean strokes a bar with the vibraphone's slow tremolo,
  -- then a brighter long-short shuffle for the promised order
  glintsVariants = Variants {
      plain = cat [
        "c5 ~ ~ ~ ~ ~ c5 ~ ~ ~ c5 ~ ~ ~ ~ ~",
        "~ ~ f5 ~ ~ ~ ~ ~ f5 ~ f5 ~ ~ ~ ~ ~",
        "bf4 ~ ~ ~ ~ ~ ~ ~ bf4 ~ ~ ~ d5 ~ ~ ~",
        "~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ g5 ~ ef5 ~"],
      utopia = cat [
        "c5 ~ g5 ~ ~ ~ c5 ~ c5 ~ ef5 ~ ~ ~ g5 ~",
        "df5 ~ f5 ~ ~ ~ df5 ~ df5 ~ af5 ~ ~ ~ f5 ~",
        "bf4 ~ d5 ~ ~ ~ bf4 ~ bf4 ~ g5 ~ ~ ~ d5 ~",
        "g4 ~ c5 ~ ~ ~ g4 ~ g4 ~ ef5 ~ ~ ~ c5 ~"] }
  glints select = swing8 $ note (select glintsVariants)
    # s "supervibe" # pF "modamp" 1.3 # pF "modfreq" 0.8 # detune 0.18
    # decay 0.6 # sustain 1.6 # room 0.85 # size 0.9 # amp 0.4
  --
  -- clear whistle pitch with a thin veil of air and slight pitch drift
  whistle = swing8 $ note (cat [
      "~ ~ ~ ~ ~ ~ ~ ~ ef7 ~ ~ ~ ~ ~ ~ ~",
      "~ ~ ~ ~ ~ ~ ~ ~ df7 ~ ~ ~ ~ ~ ~ ~",
      "~ ~ ~ ~ ~ ~ ~ ~ g6 ~ ~ ~ ~ ~ ~ ~",
      "~ ~ ~ ~ ~ ~ ~ ~ ef7 ~ ~ ~ ~ ~ ~ ~"])
    # s "hedge_whistle" # pF "limitertype" 0 # pF "vib" 4.2 # pF "depth" 0.012
    # attack 0.12 # release 0.9 # sustain 0.6
    # room 0.9 # size 0.9 # amp 0.55
  -- the answer sits on bars 2 and 4; the ask sits on bars 1 and 3
  whistleReply = when even (const silence) whistle
  whistleAsk = when odd (const silence) whistle
  --
  -- the question: a phrase, not a single note
  whistleQuestion = swing8 $ note (cat [
      "~ ~ ef7 ~ ~ ~ g6 ~ ~ ~ ~ df7 ~ ~ ~ ~",
      "~ ~ df7 ~ ~ ~ af6 ~ ~ ~ c7 ~ ~ ~ ~ ~",
      "~ ~ g6 ~ ~ ~ bf5 ~ ~ ~ ef7 ~ ~ ~ ~ ~",
      "~ ~ ef7 ~ ~ ~ c7 ~ ~ ~ g6 ~ ~ ~ ~ ~"])
    # s "hedge_whistle" # pF "limitertype" 0 # pF "vib" 4.2 # pF "depth" 0.012
    # attack 0.12 # release 1.4 # sustain 0.5
    # room 0.9 # size 0.9 # amp 0.55
  --
  -- distant horn: slow brass leaning back on the offbeat
  horn = swing8 $ note (cat [
      "~ ~ af4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~",
      "~ ~ ~ ~ ~ ~ df5 ~ ~ ~ ~ ~ ~ ~ ~ ~",
      "~ ~ g4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~",
      "~ ~ ~ ~ ~ ~ ef5 ~ ~ ~ ~ ~ ~ ~ ~ ~"])
    # s "hedge_horn" # pF "limitertype" 0 # pF "vib" 3.6 # pF "depth" 0.012
    # attack 0.3 # release 1.6 # sustain 1.2
    # pF "pan" (-0.2) # room 0.7 # size 0.8 # amp 0.85
  --
  -- elongated stabs: the utopia announcing itself
  hornStab = swing8 $ note (cat [
      "~ ~ af4 ~ ~ ~ ~ ~ ~ ~ df5 ~ ~ ~ ~ ~",
      "~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ ~ ~",
      "~ ~ df5 ~ ~ ~ ~ ~ ~ ~ ef5 ~ ~ ~ ~ ~",
      "~ ~ ~ ~ ~ ~ af4 ~ ~ ~ ~ ~ ~ ~ ~ ~"])
    # s "hedge_horn" # pF "limitertype" 0 # pF "vib" 3.6 # pF "depth" 0.012
    # attack 0.08 # release 1.8 # sustain 0.5
    # pF "pan" (-0.2) # room 0.7 # size 0.8 # amp 0.85
  --
  -- bowed shimmer, a separate voice from the plucked tremolo; four notes
  -- for the richest melodic sections
  stringsVariants = Variants {
      plain = cat [
        "af4,c5,ef5",
        "f4,af4,df5",
        "g4,bf4,c5",
        "ef4,g4,bf4"],
      utopia = cat [
        "af4,c5,ef5,af5",
        "f4,af4,df5,f5",
        "g4,bf4,c5,g5",
        "ef4,g4,bf4,ef5"] }
  strings select = slow 4 $ note (select stringsVariants)
    # s "hedge_strings" # pF "limitertype" 0
    # pF "vib" 5 # pF "depth" 0.006
    # pF "tremrate" 6.5 # pF "tremdepth" 0.18
    # attack 0.8 # release 1.4 # sustain 3.4
    # pan 0.55 # room 0.85 # size 0.9 # amp 0.9
  --
  -- reedy mid-high answer between strings and whistle; denser for utopia
  melodicaVariants = Variants {
      plain = cat [
        "c5 ~ ef5 ~ ~ ~ g5 ~ c5 ~ g5 ~ ~ ~ ef5 ~",
        "f5 ~ df5 ~ ~ ~ af5 ~ f5 ~ af5 ~ ~ ~ df5 ~",
        "g5 ~ bf4 ~ ~ ~ ef5 ~ g5 ~ ef5 ~ ~ ~ bf4 ~",
        "ef5 ~ c5 ~ ~ ~ g5 ~ ef5 ~ g5 ~ ~ ~ c5 ~"],
      utopia = cat [
        "c5 ~ ef5 ~ g5 ~ ef5 ~ c5 ~ ~ ~",
        "df5 ~ f5 ~ af5 ~ f5 ~ df5 ~ ~ ~",
        "bf4 ~ d5 ~ g5 ~ d5 ~ bf4 ~ ~ ~",
        "g4 ~ c5 ~ ef5 ~ c5 ~ g4 ~ ~ ~"] }
  melodica select = swing8 $ note (select melodicaVariants)
    # s "hedge_melodica" # pF "limitertype" 0
    # pF "vib" 5 # pF "depth" 0.01
    # pF "reed" 0.7 # pF "bright" 1700
    # attack 0.18 # release 0.7 # sustain 1.2
    # pF "pan" (-0.35) # room 0.8 # size 0.85 # amp 0.4
  --
  -- dry clockwork cuckoo: inharmonic metal ticks, two to a bar
  clock = swing8 $ note (cat [
      "~ ~ c6 ~ af5 ~ ~ ~ ~ ~ c6 ~ af5 ~ ~ ~",
      "~ ~ df6 ~ bf5 ~ ~ ~ ~ ~ df6 ~ bf5 ~ ~ ~",
      "~ ~ g5 ~ ef5 ~ ~ ~ ~ ~ g5 ~ ef5 ~ ~ ~",
      "~ ~ c6 ~ g5 ~ ~ ~ ~ ~ c6 ~ g5 ~ ~ ~"])
    # s "hedge_clock" # pF "limitertype" 0
    # pF "metal" 0.65 # decay 0.06
    # sustain 0.08 # pan 0.7 # room 0 # size 0 # amp 1.4
  --
  -- the clock turns against the promised order as the delusion fades
  clockDissonant = swing8 $ note (cat [
      "~ cs6 ~ fs5 ~ ~ ~ cs6 ~ e5 ~ ~ ~ ~ ~ ~",
      "~ ~ ~ ~ gs5 ~ as5 ~ ~ ~ ds6 ~ ~ ~ ~ ~",
      "~ fs5 ~ cs6 ~ ~ ~ e5 ~ ~ ~ gs5 ~ ~ ~ ~",
      "~ ~ as5 ~ ~ ~ ds6 ~ ~ ~ fs5 ~ cs6 ~ ~ ~"])
    # s "hedge_clock" # pF "limitertype" 0
    # pF "metal" 0.85 # decay 0.09
    # sustain 0.08 # pan 0.7 # room 0 # size 0 # amp 1.4
  --
  -- swung koto voice, clear of the mandolin
  koto select = swing8 $ note (select kotoVariants)
    # s "hedge_koto" # pF "limitertype" 0
    # pF "damp" 0.3 # pF "bend" 0.6 # pF "bright" 3200
    # decay 2.5 # sustain 2.5
    # pF "pan" (-0.55) # room 0.6 # size 0.8 # amp 0.38
  -- bent plucks: the plain figure marks the pulse, the answer is for utopia
  kotoVariants = Variants {
      plain = cat [
        "c5 ~ af4 ~ ~ ~ af4 ~ c5 ~ g4 ~ ~ ~ g4 ~",
        "df5 ~ f4 ~ ~ ~ f4 ~ df5 ~ af4 ~ ~ ~ af4 ~",
        "bf4 ~ g4 ~ ~ ~ g4 ~ bf4 ~ f4 ~ ~ ~ f4 ~",
        "g4 ~ ef4 ~ ~ ~ ef4 ~ g4 ~ c4 ~ ~ ~ c4 ~"],
      utopia = cat [
        "c5 ~ g5 ~ ~ ~ c5 ~ c5 ~ af4 ~ ~ ~ af4 ~",
        "df5 ~ af5 ~ ~ ~ df5 ~ df5 ~ bf4 ~ ~ ~ bf4 ~",
        "bf4 ~ f5 ~ ~ ~ bf4 ~ bf4 ~ g4 ~ ~ ~ g4 ~",
        "g4 ~ df5 ~ ~ ~ g4 ~ g4 ~ ef4 ~ ~ ~ ef4 ~"] }

-- 1 · Stillness — the place waits; bed alone, slowly filling in.
clearAll 64
clutchIn 1 16 bed

-- 2 · Weather — wind on the slope; the bed opens a little.
clutchIn 1 16 $ bed # lpf 1600
clutchIn 3 16 air

-- 3 · The circle — the ground is marked under the air.
clutchIn 1 16 $ bed # lpf 1900
clutchIn 5 16 lowStrings


-- 4 · The officiant with their theme
multi clutchIn 16 [
  (2, sawLead),
  (1, bed # lpf 2200),
  (4, tremolo),
  (5, lowStrings # lpf 620)]
  

-- 5 · First answer — an invitation, not a reply: saw asks on odd bars,
-- whistle answers on even.
clutchIn 2 16 sawAsk
clutchIn 7 16 whistleReply

-- 6 · The horn raised — the formal call; the bed becomes a held chord.
multi clutchIn 16 [
  (1,  ritualBed # lpf 1000),
  (2,  sawAsk # lpf 2400),
  (8,  horn),
  (12, koto plain)]

-- 7 · Frost — objects catch light; glints refuse to settle.
clutchIn 6 16 $ glints plain
clutchIn 1 16 $ ritualBed # lpf 1200


-- 8 · The interval — the mechanism wakes and starts counting.
clutchIn 1 16 $ ritualBed # lpf 1400
clutchIn 5 16 $ lowStrings # lpf 700
clutchIn 11 16 clock


-- 9 · Borrowed breath — the reed breathes without the officiant.
multi clutchIn 8 [
  (1,  ritualBed # lpf 1600),
  (10, melodica plain),
  (11, clock # pF "metal" 0.8)]

-- 10 · Handless pluck — the pluck bends sharper under the pulse.
multi clutchIn 16 [
  (1,  ritualBed # lpf 1800),
  (10, melodica plain # pF "bright" 2100),
  (12, koto plain # pF "bright" 3800)]

-- 11 · The slope joins — the whole terrain shimmers; fine grain arrives.
multi clutchIn 16 [
  (1, bed # lpf 2800),
  (3, stack [air # lpf 900, dust]),
  (5, lowStrings # lpf 820),
  (9, strings plain # release 2.0)]


-- 12 · The utopia — a perfect world in the promised order. The possessed
-- officiant believes they can build it. Richest melodic section.
glideBpm 75 90 -- from 88
multi clutchIn 12 [
  (1,  stack [bed # lpf 2800, bed # lpf 1400 # pan (-0.3) # amp 0.15]),
  (2,  sawLead # amp 0.24),
  (3,  stack [air # lpf 900 # release 2, dust # amp 0.05]),
  (4,  tremolo # room 0.85 # size 0.85 # amp 0.32),
  (6,  glints utopia # amp 0.4),
  (7,  whistle # release 1.8 # amp 0.55),
  (8,  hornStab # amp 0.85),
  (9,  strings utopia # amp 0.75),
  (10, melodica utopia # amp 0.4),
  (11, clock # amp 0.9),
  (12, koto utopia # amp 0.38) ]
--
-- Workaround: if it still fogs up, trim tails before cutting more amp
-- d9 $ strings utopia # room 0.7 # size 0.75 # amp 0.75
-- d6 $ glints utopia # room 0.7 # size 0.75 # amp 0.4

-- 13 · The call turns — whistle asks, officiant replies: the whistle was
-- asking all along. The clock starts pulling the promise out of tune.
glideBpm 88 90 -- from 75
multi clutchIn 16 [
  (2,  sawAnswer),
  (6, silence), -- resonating now
  (7,  whistleQuestion),
  (8,  silence),
  (10, silence),
  (11, clockDissonant),
  (12, silence)]

-- 7 (whistle) at this point may have become tiring. If silencing that
-- is not enough d9 (strings) is next
--
-- clutchIn 7 16 silence

-- Voices: 1 bed, 2 saw, 3 air/dust, 4 tremolo, 5 low strings, 6 glints,
-- 7 whistle, 8 horn, 9 strings, 10 melodica, 11 clock, 12 koto.
--
-- 14 · The plan outlives the builder — human signals stop; the dissonant
-- clock keeps measuring an empty utopia.
multi clutchIn 16 [
  (2,  silence),                          -- saw
  (4,  silence),                          -- tremolo
  (5,  silence),                          -- low strings
  (8,  silence),                          -- horn
  (10, silence),                          -- melodica
  (12, silence),                          -- koto
  (11, clockDissonant # pF "metal" 0.9)]  -- clock
-- for quema, leave here


-- 15 · The builder withdraws — the clock stops; the promise runs on
-- without its author.
clutchIn 6 16 silence   -- glints
clutchIn 9 16 silence   -- strings
clutchIn 11 16 silence  -- clock

-- TODO sharp ending

-- 16 · What remains — one suspended breath, unresolved; the promise
-- keeps running without the builder.
clutchIn 7 32 $ slow 4 $ note "af6 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
  # s "hedge_whistle" # pF "limitertype" 0 # pF "vib" 4.2 # pF "depth" 0.012
  # attack 0.25 # release 2.2 # sustain 0.6
  # room 0.9 # size 0.9 # amp 1.2
clutchIn 1 32 $ bed # lpf 1800 # room 0.9 # size 0.9
clutchIn 3 32 $ air # lpf 900 # release 2
-- scheduled after the coda has fully entered
waitT 1 (Sound.Tidal.Transition._clutchIn 32) 32 silence
waitT 3 (Sound.Tidal.Transition._clutchIn 32) 32 silence
waitT 6 (Sound.Tidal.Transition._clutchIn 32) 32 silence
waitT 7 (Sound.Tidal.Transition._clutchIn 32) 32 silence
waitT 9 (Sound.Tidal.Transition._clutchIn 32) 32 silence
waitT 10 (Sound.Tidal.Transition._clutchIn 32) 32 silence

-- hush only after the scheduled fade has decayed
hush
