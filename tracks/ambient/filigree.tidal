-- Filigree — ambient after the themes of quema
-- 84 BPM · A minor. No drums: drone, pad, three melodic voices, bell and air.
-- The source is quema's four-bar loop (Am7 | G7 | Fmaj7 | E7) and its opening
-- three-note turn a–c–b. That turn's intervals, +3 then -1, become the
-- modulation ladder at the scale of four-cycle loop passes: 0 3 2 5 4 7 6 9
-- 8 11 10 12 0. The same cell appears at four rates (bell, subject, toccata,
-- counter-figure), so the form is a self-similar canon rather than a variant
-- chain. Evaluate the setup block, then the sections in order.
--
-- dN is first entry: 1 drone, 2 pad, 3 subject, 4 answer, 5 toccata,
-- 6 counter-figure, 7 bell, 8 air. Double blank = landing, safe to hold.
-- Handover from quema needs seats 9 and 10 faded before d1 enters.
-- No external score; the theme is written in tracks/dance/quema.tidal.
-- Gotchas: shared rules in notes/learning/gotchas.md.

glideBpm 84 30

-- ---------------------------------------------------------------------------
-- One cell, four scales. Keep this block as one paragraph: C-RET evaluates it
-- at point. The ladder's first eight steps hold home before it starts to turn.
-- ---------------------------------------------------------------------------
let
  -- Quema's loop, one chord per cycle.
  loop :: Pattern Note
  loop = "<[a3,c4,e4,g4] [g3,b3,d4,f4] [f3,a3,c4,e4] [e3,gs3,b3,d4]>"
  --
  roots :: Pattern Note
  roots = "<a2 g2 f2 e2>"
  --
  -- The subject: quema's opening turn, a c b. Its +3 / -1 contour is the
  -- modulation ladder one scale up.
  cell :: Pattern Note
  cell = "a4 c5 b4"
  --
  revCell :: Pattern Note
  revCell = rev cell
  --
  -- One lift per four-cycle loop pass. Returns home at the end.
  lifts :: Pattern Note
  lifts = "<0 0 0 0 0 0 0 0 3 2 5 4 7 6 9 8 11 10 12 0>"
  --
  move :: Pattern Note -> Pattern Note
  move p = p |+ slow 4 lifts
  --
  -- Fugue entries: answer a fifth up one cell-note later, countersubject an
  -- octave up two notes later. The offsets land on the cell's own grid.
  subjectPlain :: Pattern Note
  subjectPlain = cell
  answerPlain :: Pattern Note
  answerPlain = off (1/3) (|+ 7) cell
  counterPlain :: Pattern Note
  counterPlain = off (2/3) (|+ 12) revCell
  --
  -- Toccata figuration is the same cell four times faster, rotated once per
  -- cycle; its shadow is the reversed cell at the same rate.
  figPlain :: Pattern Note
  figPlain = iter 3 $ fast 4 cell
  shadowPlain :: Pattern Note
  shadowPlain = iter 3 $ fast 4 revCell
  --
  -- Moved forms follow the ladder everywhere the harmony does.
  subject, answer, counter, fig, shadow :: Pattern Note
  subject = move subjectPlain
  answer = move answerPlain
  counter = move counterPlain
  fig = move figPlain
  shadow = move shadowPlain
  --
  droneVoice :: Pattern Note -> ControlPattern
  droneVoice p = note p # s "hedge_sine" # lpf 190 # lpq 0.1
    # sustain 6 # release 1 # room 0.35 # size 0.5 # amp 0.34
  --
  padVoice :: Pattern Note -> ControlPattern
  padVoice p = note p # s "hedge_pad" # sustain 5
    # lpf (range 420 1500 $ slow 24 sine)
    # room 0.6 # size 0.75 # amp 0.3
  --
  subjectVoice :: Pattern Note -> ControlPattern
  subjectVoice p = note p # s "hedge_melodica" # legato 0.85
    # pF "reed" 0.6 # pF "bright" 1600
    # attack 0.06 # release 0.4 # room 0.5 # size 0.6 # amp 0.62
  --
  answerVoice :: Pattern Note -> ControlPattern
  answerVoice p = note p # s "trumpet" # n 1 # hpf 300 # lpf 4800
    # sustain 0.5 # release 0.25 # room 0.45 # size 0.55
    # pan 0.2 # amp 0.3
  --
  figVoice :: Pattern Note -> ControlPattern
  figVoice p = note p # s "pluck" # sustain 0.25 # release 0.2
    # hpf 700 # lpf 5200 # delay 0.3 # delaytime (3/16) # delayfb 0.3
    # room 0.45 # size 0.6 # pan (-0.2) # amp 0.38
  --
  shadowVoice :: Pattern Note -> ControlPattern
  shadowVoice p = note p # s "casio" # legato 0.5
    # lpf (range 1400 3600 $ slow 12 sine)
    # delay 0.25 # delaytime (1/4) # delayfb 0.25
    # room 0.5 # size 0.65 # pan 0.25 # amp 0.26
  --
  bellVoice :: Pattern Note -> ControlPattern
  bellVoice p = note p # s "pluck" # sustain 1.2 # release 0.6
    # hpf 1200 # room 0.7 # size 0.8 # amp 0.22
  --
  air :: ControlPattern
  air = s "hedge_noise" # sustain 12 # hpf 700 # lpf 2800
    # room 0.7 # size 0.8 # amp 0.1

-- 1 · Seed. Drone, then the loop as a pad.
clutchIn 1 24 $ droneVoice roots
clutchIn 2 32 $ padVoice loop


-- 2 · Cell. Subject states the turn; the answer follows a cell-note behind,
-- a fifth up.
clutchIn 3 16 $ subjectVoice subjectPlain
clutchIn 4 16 $ answerVoice answerPlain


-- 3 · Toccata. The cell folds out at four times the rate; its reversed
-- shadow interleaves against it.
clutchIn 5 16 $ figVoice figPlain
clutchIn 6 16 $ shadowVoice shadowPlain


-- 4 · Modulation. The +3 / -1 contour becomes the key ladder: one lift per
-- loop pass. Open the pad as it starts to turn and let the air in.
multi clutchIn 24 [
  (2, padVoice (move loop) # lpf 1600),
  (3, subjectVoice subject),
  (4, answerVoice answer),
  (5, figVoice fig),
  (8, air)]


-- 5 · Fugue. The countersubject enters two notes behind the subject, an
-- octave up, and the slow bell states the same cell at a third rate.
multi clutchIn 24 [
  (6, shadowVoice shadow),
  (7, bellVoice $ slow 4 counter),
  (8, air # lpf 3600 # amp 0.14)]


-- 6 · Episode. Thin to drone, pad and toccata; the shadow drops back and the
-- pad filter drifts down under the ladder.
multi clutchIn 20 [
  (2, padVoice (move loop) # lpf 700),
  (4, silence),
  (6, shadowVoice shadow # amp 0.12),
  (7, silence)]


-- 7 · Return. Ladder home; every voice restates the plain cell at its own
-- rate. This is the full texture.
multi clutchIn 24 [
  (2, padVoice loop),
  (3, subjectVoice subjectPlain),
  (4, answerVoice answerPlain),
  (5, figVoice figPlain),
  (6, shadowVoice shadowPlain),
  (7, bellVoice (slow 4 counterPlain)),
  (8, air # amp 0.08)]


-- 8 · Coda. Take the melodic voices out and let the drone and bell ring.
multi clutchIn 32 [
  (3, silence),
  (4, silence),
  (5, silence),
  (6, silence)]
multi clutchIn 32 $ (, silence) <$> [1,2,7,8]

-- hush -- left separate: only when the tail should actually die
