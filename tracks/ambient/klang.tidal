-- 90 BPM · F minor / F Dorian. Fm | Ab | Eb | Bb, one chord per bar.
-- Seats: 1 pad, 2 air, 3 bass, 4 whistle, 5 answer. Section 4 is a landing.
-- Gotchas: shared rules in notes/learning/gotchas.md.

glideBpm 90 90

-- ---------------------------------------------------------------------------
-- Reused voices. Keep this block one paragraph: C-RET evaluates the paragraph.
let
  harm = cat [
    "[f3,af3,c4] ~ ~ ~ ~ ~ ~ ~",
    "[af3,c4,ef4] ~ ~ ~ ~ ~ ~ ~",
    "[ef3,g3,bf3] ~ ~ ~ ~ ~ ~ ~",
    "[bf2,d3,f3] ~ ~ ~ ~ ~ ~ ~"]
  harmUp = harm |+ 12
  roots = cat [
    "f2 ~ ~ ~ ~ ~ ~ ~",
    "af2 ~ ~ ~ ~ ~ ~ ~",
    "ef2 ~ ~ ~ ~ ~ ~ ~",
    "bf1 ~ ~ ~ ~ ~ ~ ~"]
  hook = cat [
    "c5 _ f5 _ af5 _ c6 _",
    "c6 _ ef6 _ c6 _ af5 _",
    "bf5 _ af5 _ g5 _ bf5 _",
    "d5 _ f5 _ d5 _ bf4 _"]
  hook2 = cat [
    "f5 _ _ _ af5 _ _ _",
    "c6 _ _ _ bf5 _ af5 _",
    "bf5 _ _ _ af5 _ _ _",
    "g5 _ _ _ f5 _ _ _"]
  space p = p # room 0.9 # size 0.85
  pad = space $ n harm # s "hedge_pad" # legato 0.9 # lpf 1800 # amp 2
  padUp = space $ n harmUp # s "hedge_pad" # legato 0.9 # lpf 2200 # amp 1.6
  bass = speedAt "g1" roots # s "moog:3" # lpf 300
    # room 0.3 # size 0.5
  whistle = note hook # s "hedge_whistle" # legato 0.9 # attack 0.05 # release 0.2
    # pF "limitertype" 0 # pF "vib" 4.2 # pF "depth" 0.012
    # room 0.85 # size 0.8 # amp 0.45
  answer = space $ note hook2 # s "hedge_strings" # legato 1.1 # amp 0.5
  air = slow 8 $ s "wind:4" # speed 0.65 # pan rand
    # room 0.95 # size 0.9 # lpf 900 # amp 0.3

-- 1. pad and air — establish the four-bar loop (8 cycles).
multi clutchIn 8 [(1, pad), (2, air)]

-- 2. bass enters (8 cycles).
xfadeIn 3 8 bass

-- 3. whistle enters
clutchIn 4 64 whistle

-- 4. landing. The full texture holds here — dwell, or detach to mix another
-- intro in. Nothing to evaluate.


-- 5. answer voice; pad moves up an octave (8 cycles).
multi clutchIn 64 [
  (1, padUp),
  (5, answer)]


-- 6. strip back — whistle and answer out, bass filtered down, pad returns
-- to its root voicing (8 cycles).
multi xfadeIn 64 [
  (1, pad),
  (3, bass # lpf 200),
  (4, silence),
  (5, silence)]


-- 7. outro. Let the last chord ring before fading.
fadeSilence 16 [1,2,3,4,5]
