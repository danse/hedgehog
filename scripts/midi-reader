#!/usr/bin/env python3
"""Read a MIDI file and print its voices as a grid, with no deps.

The one-off parses of MIDI exports live here so they survive a /tmp wipe, the
same way analyse-audio.py holds the audio ones. Note-on/off events are paired
per pitch in each track; notes are named in Tidal spelling (fs4, bf3, ...).

Usage:
  scripts/midi-reader FILE.mid [--steps N] [--bars N] [--compact | --gates]

Output: header, tempo changes, then one block per voice. Grid cells show the
note name followed by `_` for each further step it is held, clamped at the next
note in that voice. Default is 16 steps/bar (16ths). Use `--steps` for scores
on another grid: `salem.midi`, for instance, is written on 60 steps/bar
(1/15 quarter), so `--steps 60` renders its holds exactly. By default only
bars containing notes are printed; `--bars N` prints exactly N bars per voice
including empty ones, so a Tidal `cat` list stays aligned with the MIDI.
`--compact` prints each note or rest as `token@count` steps; `--gates` instead
prints a long `t`/`~` onset grid, ready for Tidal `struct`. The raw list above
each grid gives exact tick positions and durations, which is the detail to
trust when writing mini-notation.
"""
import argparse
import struct
import sys

NAMES = ["c", "cs", "d", "ds", "e", "f", "fs", "g", "gs", "a", "as", "b"]


def note_name(pitch):
    """Tidal spelling: MIDI 60 is c5 (note value 0), not c4."""
    return NAMES[pitch % 12] + str(pitch // 12)


def varlen(data, i):
    """Read a MIDI variable-length quantity at i; return (value, next i)."""
    value = 0
    while True:
        byte = data[i]
        i += 1
        value = (value << 7) | (byte & 0x7F)
        if not byte & 0x80:
            return value, i


def read_midi(path):
    """Return (division, tempo_changes, tracks) from a format 0/1 MIDI file."""
    data = open(path, "rb").read()
    if data[:4] != b"MThd":
        raise ValueError("not a MIDI file: " + path)
    fmt, ntracks, division = struct.unpack(">HHH", data[8:14])
    if fmt not in (0, 1):
        raise ValueError("unsupported MIDI format %d" % fmt)

    pos = 14
    tempos, tracks = [], []
    for _ in range(ntracks):
        if data[pos:pos + 4] != b"MTrk":
            raise ValueError("missing MTrk at byte %d" % pos)
        length = struct.unpack(">I", data[pos + 4:pos + 8])[0]
        track = data[pos + 8:pos + 8 + length]
        pos += 8 + length
        i, tick, running = 0, 0, None
        name, events = "", []
        while i < len(track):
            delta, i = varlen(track, i)
            tick += delta
            status = track[i]
            if status & 0x80:
                i += 1
                running = status
            else:
                status = running
            if status == 0xFF:
                kind = track[i]
                i += 1
                size, i = varlen(track, i)
                body = track[i:i + size]
                i += size
                if kind == 0x03:
                    name = body.decode("utf-8", "replace")
                elif kind == 0x51:
                    us = int.from_bytes(body, "big")
                    tempos.append((tick, round(60000000 / us, 2)))
                elif kind == 0x58 and len(body) >= 2:
                    events.append((tick, "timesig", (body[0], 2 ** body[1])))
            elif status in (0xF0, 0xF7):
                size, i = varlen(track, i)
                i += size
            else:
                nargs = 1 if status & 0xF0 in (0xC0, 0xD0) else 2
                args = track[i:i + nargs]
                i += nargs
                if status & 0xF0 == 0x90 and args[1] > 0:
                    events.append((tick, "on", args[0]))
                elif status & 0xF0 == 0x80 or (status & 0xF0 == 0x90):
                    events.append((tick, "off", args[0]))
        tracks.append((name, events))
    return division, tempos, tracks


def pair_notes(events):
    """Pair note-on/off per pitch; return (start, end, pitch) triples.

    `_` in the grid comes from these note-offs (0x80 or 0x90 velocity 0).
    Not covered yet: exports with no note-off that let the next note-on end
    the previous note, notes left open at end of track (dropped here), and
    overlapping same-pitch notes in one track, which are paired in order and
    may mispair. Extend this function if a file shows any of those.
    """
    active, notes = {}, []
    for tick, kind, pitch in events:
        if kind == "on":
            active.setdefault(pitch, []).append(tick)
        elif active.get(pitch):
            notes.append((active[pitch].pop(0), tick, pitch))
    return sorted(notes)


def grid(notes, ticks_per_bar, steps=16, compact=False, gates=False,
         total_bars=None):
    """Render notes onto `steps` equal cells per bar; `_` continues a note.

    `total_bars` prints that many bars including empty ones; otherwise only
    bars with notes appear. `compact` prints `token@count` runs. `gates`
    instead prints a long `t`/`~` line with `t` only at note onsets, ready for
    Tidal `struct`.
    """
    step = ticks_per_bar / steps
    bars = {}
    for start, end, pitch in notes:
        bars.setdefault(start // ticks_per_bar, []).append((start, end, pitch))
    indices = range(total_bars) if total_bars is not None else sorted(bars)
    lines = []
    for bar in indices:
        cells = ["~"] * steps
        for k, (start, end, pitch) in enumerate(sorted(bars.get(bar, []))):
            col = min(steps - 1, max(0, round((start % ticks_per_bar) / step)))
            held = max(1, round((end - start) / step))
            if k + 1 < len(bars.get(bar, [])):
                nxt = sorted(bars.get(bar, []))[k + 1][0]
                held = min(held, max(1, round((nxt - start) / step)))
            cells[col] = note_name(pitch)
            for held_step in range(1, held):
                if col + held_step < steps:
                    cells[col + held_step] = "_"
        if gates:
            cells = ["t" if c not in ("_", "~") else "~" for c in cells]
        elif compact:
            # `note@N` is one event N steps long; `~@N` is N steps of rest.
            # That is both exact and readable, unlike long `_!N` runs.
            tokens, i = [], 0
            while i < len(cells):
                token = cells[i]
                j = i + 1
                while j < len(cells) and cells[j] == ("_" if token != "~" else "~"):
                    j += 1
                tokens.append("%s@%d" % (token, j - i))
                i = j
            cells = tokens
        lines.append('    "%s"' % " ".join(cells))
    return lines


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("file", help="MIDI file to read")
    ap.add_argument("--steps", type=int, default=16, metavar="N",
                    help="grid steps per bar (default: 16, i.e. 16ths)")
    ap.add_argument("--bars", type=int, metavar="N",
                    help="print exactly N bars per voice, including empty ones")
    style = ap.add_mutually_exclusive_group()
    style.add_argument("--compact", action="store_true",
                       help="print each note/rest as token@count steps for Tidal")
    style.add_argument("--gates", action="store_true",
                       help="print a long t/~ onset grid for Tidal struct")
    args = ap.parse_args()
    if args.steps < 1:
        raise ValueError("--steps must be positive")
    if args.bars is not None and args.bars < 1:
        raise ValueError("--bars must be positive")

    division, tempos, tracks = read_midi(args.file)
    # Time signatures live in the conductor track, so gather them across all
    # tracks rather than reading each voice in isolation.
    timesigs = [ts for _, ev in tracks for _, kind, ts in ev if kind == "timesig"]
    num, den = timesigs[0] if timesigs else (4, 4)
    ticks_per_bar = division * 4 * num // den
    print("division %d ticks/quarter · %d/%d, %d ticks/bar · %d steps/bar"
          % (division, num, den, ticks_per_bar, args.steps))
    for tick, bpm in tempos:
        print("tick %5d  %g BPM" % (tick, bpm))

    for name, events in tracks:
        notes = pair_notes(events)
        if not notes:
            continue
        print("\n-- %s (%d notes)" % (name or "voice", len(notes)))
        for start, end, pitch in notes:
            length = end - start
            print("  %5d → %5d  %-4s  %5d ticks (%.2f steps)"
                  % (start, end, note_name(pitch), length,
                     length / (ticks_per_bar / args.steps)))
        print("  grid:")
        for line in grid(notes, ticks_per_bar, args.steps,
                         args.compact, args.gates, args.bars):
            print(line)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, IndexError) as exc:
        sys.exit("midi-reader: %s" % exc)
