-- Hedgehog — ambient live set
-- 72 BPM, D minor. Eval this block first (C-RET).

setbpm 72

-- Layers. Each definition is one paragraph: eval once after boot.
-- Re-eval a definition only when you want to change that instrument.

-- Two SuperDirt gotchas, both silent-show-stoppers:
--  1. `size` is valid 0..1 only. Above ~0.9 the feedback gain in
--     `dirt_reverb` exceeds unity and the orbit self-oscillates at full
--     scale — and keeps ringing after hush. Never write size > 0.9.
--  2. `gain` is not linear: amp = amp * gain^4. gain 0.5 is -24 dB, not
--     "half". Keep layers in 0.75..1.0 and trim with `amp` (linear) instead.
-- Baseline is gain 1.0, so these numbers are the whole mix balance.
let bed = slow 8 $ s "padlong" # gain 0.88 # room 0.95 # size 0.9 # lpf 1400

let drone = slow 8 $ s "hedge_sine" # note "d3" # sustain 28 # gain 0.88 # lpf 240 # room 0.8

let air = slow 4 $ s "wind:4" # speed 0.65 # pan rand # gain 0.8 # room 0.95 # size 0.9 # lpf 900

let birds = slow 4 $ s "birds:2" # speed (range 0.7 1.05 rand) # pan rand # gain 0.85 # room 0.9 # size 0.85 # lpf 3400

let tick = slow 2 $ s "click:2(3,16,2)" # gain 0.76 # pan 0.3 # room 0.6 # size 0.7 # lpf 2400

let pad = slow 4 $ note "[d4,f4,a4,c5,e5] [c4,e4,g4,b4] [bb3,d4,f4,a4] [a3,c4,e4,g4]" # s "hedge_pad" # sustain 4 # gain 0.85 # room 0.95 # size 0.85

let pluck = slow 4 $ note "d5 ~ ~ f5 ~ a5 ~ ~" # s "pluck" # gain 0.85 # delay 0.7 # delaytime 0.375 # room 0.9 # size 0.8 # lpf 2600

let riser = s "hedge_noise" # sustain 4 # gain (range 0.5 0.88 $ slow 4 saw) # lpf (range 300 5000 $ slow 4 saw) # room 0.9
